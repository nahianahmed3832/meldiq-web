# Meldiq Web: configuration (placeholders only, never real credentials).
#
# EVERYTHING the browser receives is public. The web app has no secrets: no database URL, no AWS keys, no OAuth client
# secrets, no signing keys. Those belong to the API's own environment (Orbit repository, deploy/.env.example) and never
# here. Vite exposes only VITE_* variables to the bundle, and this app reads none; the values below reach the browser
# only through /config.json, written at install time (deploy/scripts/install-release.sh).
#
# Development: copy to .env.local if you want to override defaults (npm run dev reads the shell environment).

# ── Public: written into /config.json for the browser ───────────────────────────────────────────────
# The API origin the browser calls. Empty = same origin (recommended): the site's own nginx proxies /v1 and /v2.
# Set it only for a cross-origin API, which must then list MELDIQ_WEB_BASE_URL in the API's WEB_ORIGINS.
MELDIQ_API_BASE_URL=
# The realtime URL; empty = derived (wss://<site>/v1/ws, or from MELDIQ_API_BASE_URL).
MELDIQ_WS_URL=
# This site's public address. Planned: https://web.meldiq.app (not active yet). Current target: https://web.griipbuddy.cloud
MELDIQ_WEB_BASE_URL=https://web.example.com
# development | staging | production
MELDIQ_ENVIRONMENT=development

# ── Web host only (not secret, never sent to browsers) ─────────────────────────────────────────────
# Where /v1 and /v2 are proxied: the existing API container. Dev default http://127.0.0.1:8080; production 127.0.0.1:18080.
MELDIQ_API_UPSTREAM=http://127.0.0.1:8080
# Extra CSP connect-src entries: LiveKit signalling and the S3 bucket (presigned uploads/downloads).
MELDIQ_CONNECT_EXTRA="https://rtc.example.com wss://rtc.example.com https://BUCKET.s3.REGION.amazonaws.com"

# ── Development and test tooling (earlier names, still read) ────────────────────────────────────────
# The Orbit server folder the tests and local tools start (defaults to a clone next to this repository).
# ORBIT_SERVER_DIR=/path/to/griip-mesage/server
# Earlier name of MELDIQ_API_UPSTREAM for the dev proxy and demo tools.
# ORBIT_API_URL=http://127.0.0.1:8080
