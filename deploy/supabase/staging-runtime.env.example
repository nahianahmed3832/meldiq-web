# Private server-side file for the explicit staged composition and smoke harness.
# The production entry point is gated; these variables do not activate PostgreSQL in production.
# This file must be outside Git with permissions 600. It must not contain the Auth administrator key.
SUPABASE_ENVIRONMENT=staging
SUPABASE_EXPECTED_PROJECT_REF=bkvlxbsnzqkhbifawcww
SUPABASE_DATABASE_URL=postgresql://meldiq_staging_runtime.PROJECT_REF:ENCODED_PASSWORD@VERIFIED_SESSION_POOLER:5432/postgres
SUPABASE_DB_CA_FILE=/private/path/supabase-root.crt
