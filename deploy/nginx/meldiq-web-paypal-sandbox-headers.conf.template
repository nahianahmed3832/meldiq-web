# LOCAL/STAGING SANDBOX ONLY. Do not install in production.
# Security headers for Meldiq Web (docs/ORBIT_WEB_DEPLOYMENT.md › Headers). ${CONNECT_EXTRA}: LiveKit and the S3 bucket.
add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://www.sandbox.paypal.com https://www.paypalobjects.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https://*.sandbox.paypal.com https://www.paypalobjects.com; media-src 'self' blob:; frame-src https://www.youtube-nocookie.com https://*.sandbox.paypal.com; font-src 'self'; connect-src https://*.sandbox.paypal.com https://www.paypalobjects.com 'self' wss://${WEB_HOST} ${CONNECT_EXTRA}; object-src 'none'; base-uri 'none'; form-action https://*.sandbox.paypal.com; frame-ancestors 'none'; upgrade-insecure-requests" always;
add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "no-referrer" always;
add_header Cross-Origin-Opener-Policy "same-origin-allow-popups" always;
add_header Cross-Origin-Resource-Policy "same-origin" always;
add_header Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=(self), payment=(), usb=()" always;
add_header Strict-Transport-Security "max-age=31536000" always;
