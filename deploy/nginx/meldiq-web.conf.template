# Meldiq Web: static files and a same-origin proxy to the existing API (shared with the Android app) (docs/ORBIT_WEB_DEPLOYMENT.md).
# Rendered by deploy/scripts/install-release.sh from these variables:
#   ${WEB_HOST}      the public host, e.g. web.griipbuddy.cloud now, web.meldiq.app later
#   ${API_UPSTREAM}  the API container on this machine, e.g. 127.0.0.1:18080
#   ${WEB_ROOT}      /opt/meldiq-web/current
# Defines its own upgrade map (a unique name, so it can't clash with other sites' maps).
# Behind Cloudflare (since 2026-10-28): both server blocks include /etc/nginx/snippets/meldiq-cloudflare-realip.conf
# (meldiq_android deploy/nginx), so $remote_addr and X-Forwarded-For carry the visitor. nginx -t fails without the file,
# which stops a release rather than letting the API rate-limit everyone as Cloudflare.

map $http_upgrade $meldiq_web_connection_upgrade {
  default upgrade;
  '' close;
}

server {
  listen 80;
  listen [::]:80;
  server_name ${WEB_HOST};
  include /etc/nginx/snippets/meldiq-cloudflare-realip.conf;  # visitor address behind Cloudflare
  location /.well-known/acme-challenge/ { root /var/www/html; }
  location / { return 301 https://$host$request_uri; }
}

server {
  # `listen … http2` rather than `http2 on;`: the VPS runs nginx 1.24, which predates the newer directive.
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name ${WEB_HOST};
  include /etc/nginx/snippets/meldiq-cloudflare-realip.conf;  # visitor address behind Cloudflare

  ssl_certificate /etc/letsencrypt/live/${WEB_HOST}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${WEB_HOST}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;

  root ${WEB_ROOT};
  index index.html;
  server_tokens off;
  access_log /var/log/nginx/meldiq-web.access.log;
  error_log /var/log/nginx/meldiq-web.error.log warn;

  # The realtime connection: long-lived, upgraded. The app pings every 25 s.
  location = /v1/ws {
    proxy_pass http://${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $meldiq_web_connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
  }

  # The API, same origin: no CORS. Attachments up to 1 GiB (FILE_MAX_BYTES + chunk tags) stream through unbuffered.
  location ~ ^/v[12]/ {
    proxy_pass http://${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    client_max_body_size 1100m;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  # Files kept in S3, fetched for browsers the bucket doesn't allow yet (snippets/meldiq-web-media.conf).
  include /etc/nginx/snippets/meldiq-web-media.conf;

  # Android App Links and passkeys (the app verifies web.meldiq.app/invite/ and /m/): the API's Digital Asset Links,
  # never the app page. Android doesn't follow redirects here, so it's answered directly.
  location = /.well-known/assetlinks.json {
    limit_except GET { deny all; }
    proxy_pass http://${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Runtime configuration: never cached, so a domain or API change applies at the next page load.
  location = /config.json {
    add_header Cache-Control "no-store" always;
    include /etc/nginx/snippets/meldiq-web-headers.conf;
    try_files $uri =404;
  }

  # Content-hashed build files: cached for a year. /_next/static/ is the Next.js build (0.6+); /assets/ the Vite builds
  # before it, kept so a rollback to one still gets its caching.
  location /_next/static/ {
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    include /etc/nginx/snippets/meldiq-web-headers.conf;
    try_files $uri =404;
  }
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    include /etc/nginx/snippets/meldiq-web-headers.conf;
    try_files $uri =404;
  }

  # The service worker (background notifications): always checked for a new version, never the app page instead.
  location = /sw.js {
    add_header Cache-Control "no-cache" always;
    include /etc/nginx/snippets/meldiq-web-headers.conf;
    try_files $uri =404;
  }

  # Batch B4b: invitation links (meldiq.app/invite/CODE) land on a small static page, not the web app.
  location ^~ /invite/ {
    add_header Cache-Control "no-cache" always;
    include /etc/nginx/snippets/meldiq-web-headers.conf;
    try_files /invite.html =404;
  }

  location / {
    add_header Cache-Control "no-cache" always;
    include /etc/nginx/snippets/meldiq-web-headers.conf;
    try_files $uri /index.html;
  }
}
