+import "fake-indexeddb/auto";
+import { afterEach, describe, expect, it } from "vitest";
+import { LocalStore } from "../src/store/db";
+import { EncryptedSupabaseStorage, createMeldiqSupabase } from "../src/auth/supabaseClient";
+import { SupabaseInvalidation } from "../src/realtime/supabaseEvents";
+
+let store: LocalStore | undefined;
+afterEach(() => {
+  store?.close();
+});
+describe("staged Supabase client security", () => {
+  it("seals tokens at rest and reads them after reopening", async () => {
+    const name = `supabase-vault-${crypto.randomUUID()}`;
+    store = await LocalStore.open(name);
+    await new EncryptedSupabaseStorage(store).setItem("session", "synthetic-refresh-token");
+    const sealed = await store.legacy.get("kv", "supabase:sealed:session");
+    expect(JSON.stringify(sealed)).not.toContain("synthetic-refresh-token");
+    store.close();
+    store = await LocalStore.open(name);
+    expect(await new EncryptedSupabaseStorage(store).getItem("session")).toBe("synthetic-refresh-token");
+  });
+  it("serializes concurrent wrapping-key creation", async () => {
+    store = await LocalStore.open(`supabase-concurrent-${crypto.randomUUID()}`);
+    await Promise.all([new EncryptedSupabaseStorage(store).setItem("first", "one"), new EncryptedSupabaseStorage(store).setItem("second", "two")]);
+    const storage = new EncryptedSupabaseStorage(store);
+    expect(await storage.getItem("first")).toBe("one");
+    expect(await storage.getItem("second")).toBe("two");
+  });
+  it("rejects a ciphertext moved to another session key and removes only the corrupt entry", async () => {
+    store = await LocalStore.open(`supabase-tamper-${crypto.randomUUID()}`);
+    const storage = new EncryptedSupabaseStorage(store);
+    await storage.setItem("first", "one");
+    await store.legacy.put("kv", await store.legacy.get("kv", "supabase:sealed:first"), "supabase:sealed:second");
+    expect(await storage.getItem("second")).toBeNull();
+    expect(await storage.getItem("first")).toBe("one");
+    await storage.removeItem("first");
+    expect(await storage.getItem("first")).toBeNull();
+  });
+  it("rejects privileged keys and mismatched project origins before constructing a client", async () => {
+    store = await LocalStore.open(`supabase-config-${crypto.randomUUID()}`);
+    expect(() => createMeldiqSupabase({ url: "https://stage.supabase.co", projectRef: "stage", publishableKey: "sb_secret_never-public" }, store!)).toThrow("publishable");
+    expect(() => createMeldiqSupabase({ url: "https://other.supabase.co", projectRef: "stage", publishableKey: "sb_publishable_test" }, store!)).toThrow("origin");
+  });
+  it("validates invalidation IDs and refuses message content/entitlement injection", () => {
+    const event = { eventId: crypto.randomUUID(), messageId: "message001", conversationId: "conversation001" };
+    expect(SupabaseInvalidation.safeParse(event).success).toBe(true);
+    expect(SupabaseInvalidation.safeParse({ ...event, text: "forged", subscription: "plus" }).success).toBe(false);
+  });
+});
diff --git a/test/supabase-events.test.ts b/test/supabase-events.test.ts
new file mode 100644
index 0000000..ed2581e
--- /dev/null
+++ b/test/supabase-events.test.ts
@@ -0,0 +1,120 @@
+import { describe, expect, it, vi } from "vitest";
+import type { SupabaseClient, RealtimeChannel } from "@supabase/supabase-js";
+import { SupabaseEventSubscription } from "../src/realtime/supabaseEvents";
+
+function fixture() {
+  const channels: { topic: string; emit: (payload: unknown) => void; status: (value: string) => void }[] = [];
+  const remove = vi.fn(async (_channel: unknown) => "ok");
+  const auth = vi.fn(async (_token: string) => undefined);
+  const client = {
+    realtime: { setAuth: auth },
+    removeChannel: remove,
+    channel: (topic: string, options: unknown) => {
+      expect(options).toMatchObject({ config: { private: true } });
+      const item = { topic, emit: (_payload: unknown) => {}, status: (_status: string) => {} };
+      channels.push(item);
+      const channel = {
+        on: (_kind: string, _filter: unknown, handler: (event: { payload: unknown }) => void) => {
+          item.emit = (payload) => {
+            handler({ payload });
+          };
+          return channel;
+        },
+        subscribe: (handler: (value: string) => void) => {
+          item.status = handler;
+          handler("SUBSCRIBED");
+          return channel;
+        },
+      };
+      return channel as unknown as RealtimeChannel;
+    },
+  } as unknown as SupabaseClient;
+  return { client, channels, remove, auth };
+}
+const payload = () => ({ eventId: crypto.randomUUID(), messageId: "message001", conversationId: "conversation001" });
+
+describe("private Supabase invalidation lifecycle", () => {
+  it("deduplicates delivery and recovers durable history after each reconnect", async () => {
+    const f = fixture(),
+      apply = vi.fn(async () => {}),
+      recover = vi.fn(async () => {});
+    const subscription = new SupabaseEventSubscription(f.client, apply, recover, () => {});
+    await subscription.start("user:fixture", "synthetic-access-token");
+    const event = payload();
+    f.channels[0].emit(event);
+    f.channels[0].emit(event);
+    await vi.waitFor(() => {
+      expect(apply).toHaveBeenCalledTimes(1);
+    });
+    f.channels[0].status("SUBSCRIBED");
+    await vi.waitFor(() => {
+      expect(recover).toHaveBeenCalledTimes(2);
+    });
+    await subscription.stop();
+  });
+  it("serializes events and allows a failed invalidation to be retried", async () => {
+    const f = fixture(),
+      errors = vi.fn();
+    let first = true;
+    const apply = vi.fn(async () => {
+      if (first) {
+        first = false;
+        throw new Error("synthetic temporary failure");
+      }
+    });
+    const subscription = new SupabaseEventSubscription(f.client, apply, async () => {}, errors);
+    await subscription.start("conversation:fixture", "synthetic-token");
+    const event = payload();
+    f.channels[0].emit(event);
+    await vi.waitFor(() => {
+      expect(errors).toHaveBeenCalledOnce();
+    });
+    f.channels[0].emit(event);
+    await vi.waitFor(() => {
+      expect(apply).toHaveBeenCalledTimes(2);
+    });
+    await subscription.stop();
+  });
+  it("refuses malformed events and callbacks from a stopped account", async () => {
+    const f = fixture(),
+      apply = vi.fn(async () => {});
+    const subscription = new SupabaseEventSubscription(
+      f.client,
+      apply,
+      async () => {},
+      () => {},
+    );
+    await subscription.start("user:fixture", "synthetic-token");
+    f.channels[0].emit({ ...payload(), entitlement: "plus" });
+    await subscription.stop();
+    f.channels[0].emit(payload());
+    await Promise.resolve();
+    expect(apply).not.toHaveBeenCalled();
+  });
+  it("does not let an older account switch replace a newer subscription", async () => {
+    const f = fixture();
+    let release: (() => void) | undefined;
+    const subscription = new SupabaseEventSubscription(
+      f.client,
+      async () => {},
+      async () => {},
+      () => {},
+    );
+    await subscription.start("user:first", "first-token");
+    f.remove.mockImplementationOnce(
+      async () =>
+        new Promise<string>((resolve) => {
+          release = () => {
+            resolve("ok");
+          };
+        }),
+    );
+    const older = subscription.start("user:older", "older-token");
+    await Promise.resolve();
+    await subscription.start("user:latest", "latest-token");
+    release!();
+    await older;
+    expect(f.channels.map((channel) => channel.topic)).toEqual(["user:first", "user:latest"]);
+    await subscription.stop();
+  });
+});
diff --git a/test/supabase-migration.test.ts b/test/supabase-migration.test.ts
new file mode 100644
index 0000000..41982ca
--- /dev/null
+++ b/test/supabase-migration.test.ts
@@ -0,0 +1,113 @@
+import { describe, expect, it, vi } from "vitest";
+import { AuthMigrationError, prepareLegacySupabaseLink, prepareSupabaseDevice } from "../src/auth/supabaseMigration";
+
+const authUserId = "10000000-0000-4000-8000-000000000001",
+  sessionId = "20000000-0000-4000-8000-000000000001";
+const token = `eyJhbGciOiJFUzI1NiJ9.${btoa(JSON.stringify({ sub: authUserId, session_id: sessionId, user_metadata: { userId: "forged" } })).replace(/=/g, "")}.signature`;
+const owner = Object.freeze({ accountId: "account_original", userId: "user_original", deviceId: "device_original" });
+const signature = btoa("s".repeat(64)),
+  nonce = "synthetic_one_use_nonce_12345678";
+function fixture() {
+  const responses: unknown[] = [{ nonce, expiresAt: Date.now() + 120000 }, { ok: true }, { authUserId, accountId: owner.accountId, userId: owner.userId }];
+  const request = vi.fn<typeof fetch>().mockImplementation(async () => new Response(JSON.stringify(responses.shift()), { status: 200, headers: { "content-type": "application/json" } }));
+  const signDeviceProof = vi.fn(async (_message: string) => signature);
+  const options = {
+    apiOrigin: "https://api.example.test",
+    providerSession: { access_token: token, user: { id: authUserId } },
+    expectedOwner: owner,
+    signDeviceProof,
+    legacyAccessToken: "synthetic_legacy_access_token_123456",
+    password: "synthetic old password",
+    totpCode: "123456",
+    fetch: request,
+  };
+  return { options, request, signDeviceProof, responses };
+}
+describe("staged web account migration transport", () => {
+  it("signs the exact provider/session/device/nonce context and confirms original ownership before returning a receipt", async () => {
+    const f = fixture();
+    expect(await prepareLegacySupabaseLink(f.options)).toEqual({ ...owner, authUserId, providerSessionId: sessionId });
+    expect(f.signDeviceProof).toHaveBeenCalledWith(`meldiq-supabase-device-v1\n${authUserId}\n${sessionId}\n${owner.deviceId}\n${nonce}`);
+    const [url, init] = f.request.mock.calls[1];
+    expect(url).toBe("https://api.example.test/v3/auth/legacy-link");
+    expect(JSON.parse(String(init?.body))).toEqual({ deviceId: owner.deviceId, nonce, signature, legacyAccessToken: f.options.legacyAccessToken, password: f.options.password, totpCode: "123456" });
+    expect(f.options.expectedOwner).toBe(owner);
+  });
+  it("prevents credential redirects, shared caching and incidental cookie transmission", async () => {
+    const f = fixture();
+    await prepareLegacySupabaseLink(f.options);
+    for (const [url, init] of f.request.mock.calls) {
+      expect(String(url)).not.toContain(f.options.legacyAccessToken);
+      expect(String(url)).not.toContain(f.options.password);
+      expect(init).toMatchObject({ redirect: "error", cache: "no-store", credentials: "omit", headers: { authorization: `Bearer ${token}` } });
+    }
+  });
+  it("rejects mismatched ownership without changing the existing identity or SDK session", async () => {
+    const f = fixture();
+    f.responses[2] = { authUserId, accountId: owner.accountId, userId: "someone_else" };
+    const before = structuredClone(f.options.providerSession);
+    await expect(prepareLegacySupabaseLink(f.options)).rejects.toMatchObject({ code: "identity_mismatch" });
+    expect(f.options.expectedOwner).toEqual(owner);
+    expect(f.options.providerSession).toEqual(before);
+  });
+  it("does not infer ownership from JWT metadata or an unrelated provider session", async () => {
+    const f = fixture();
+    f.options.providerSession.user.id = "10000000-0000-4000-8000-000000000002";
+    await expect(prepareLegacySupabaseLink(f.options)).rejects.toMatchObject({ code: "invalid_provider_session" });
+    expect(f.request).not.toHaveBeenCalled();
+    expect(f.signDeviceProof).not.toHaveBeenCalled();
+  });
+  it("refuses insecure nonlocal or credential-bearing API origins before sending secrets", async () => {
+    for (const apiOrigin of ["http://api.example.test", "https://user:password@api.example.test", "https://api.example.test/?redirect=evil", "https://api.example.test/path"]) {
+      const f = fixture();
+      await expect(prepareLegacySupabaseLink({ ...f.options, apiOrigin })).rejects.toMatchObject({ code: "invalid_api_origin" });
+      expect(f.request).not.toHaveBeenCalled();
+    }
+  });
+  it("supports a later certified-device binding without resending legacy credentials", async () => {
+    const f = fixture();
+    await prepareSupabaseDevice(f.options);
+    expect(f.request.mock.calls[1][0]).toBe("https://api.example.test/v3/auth/device");
+    expect(JSON.parse(String(f.request.mock.calls[1][1]?.body))).not.toHaveProperty("legacyAccessToken");
+    expect(JSON.parse(String(f.request.mock.calls[1][1]?.body))).not.toHaveProperty("password");
+  });
+  it("keeps failure messages free of server text, tokens and passwords", async () => {
+    const f = fixture();
+    f.request.mockResolvedValueOnce(new Response(JSON.stringify({ error: { code: "unauthorized", message: `${token} ${f.options.password}` } }), { status: 401 }));
+    try {
+      await prepareLegacySupabaseLink(f.options);
+      throw new Error("expected refusal");
+    } catch (error) {
+      expect(error).toBeInstanceOf(AuthMigrationError);
+      expect(error).toMatchObject({ code: "unauthorized", status: 401 });
+      expect(String(error)).not.toContain(f.options.password);
+      expect(String(error)).not.toContain(token);
+    }
+    expect(f.signDeviceProof).not.toHaveBeenCalled();
+  });
+  it("refuses expired challenges before signing or linking", async () => {
+    const f = fixture();
+    f.responses[0] = { nonce, expiresAt: Date.now() - 1 };
+    await expect(prepareLegacySupabaseLink(f.options)).rejects.toMatchObject({ code: "invalid_device_challenge" });
+    expect(f.signDeviceProof).not.toHaveBeenCalled();
+    expect(f.request).toHaveBeenCalledTimes(1);
+  });
+  it("keeps one provider token throughout an in-flight proof when the caller's SDK state changes", async () => {
+    const f = fixture();
+    f.request.mockImplementationOnce(async () => {
+      f.options.providerSession.access_token = "a_different_sdk_session";
+      f.responses.shift();
+      return new Response(JSON.stringify({ nonce, expiresAt: Date.now() + 120000 }), { status: 200 });
+    });
+    await prepareLegacySupabaseLink(f.options);
+    for (const [, init] of f.request.mock.calls) expect(init?.headers).toMatchObject({ authorization: `Bearer ${token}` });
+  });
+  it("returns only owner identifiers and rejects a malformed server challenge", async () => {
+    const f = fixture();
+    const result = await prepareLegacySupabaseLink({ ...f.options, expectedOwner: { ...owner, privateKey: "must-not-copy" } } as typeof f.options);
+    expect(result).not.toHaveProperty("privateKey");
+    const broken = fixture();
+    broken.responses[0] = null;
+    await expect(prepareLegacySupabaseLink(broken.options)).rejects.toMatchObject({ code: "invalid_device_challenge" });
+  });
+});
