new file mode 100644
index 0000000..36f08d1
--- /dev/null
+++ b/src/auth/supabaseClient.ts
@@ -0,0 +1,91 @@
+import { createClient, type SupabaseClient } from "@supabase/supabase-js";
+import type { LocalStore } from "../store/db";
+import { copy, utf8, fromUtf8, randomBytes } from "../crypto/bytes";
+
+const WRAPPING_KEY = "supabase:wrapping-key:v1";
+const entry = (key: string) => `supabase:sealed:${key}`;
+interface SealedValue {
+  version: 1;
+  iv: Uint8Array;
+  ciphertext: Uint8Array;
+}
+
+/** Supabase's storage adapter uses the existing device IndexedDB, never plaintext localStorage. */
+export class EncryptedSupabaseStorage {
+  private wrappingKey: Promise<CryptoKey> | undefined;
+  constructor(private readonly store: LocalStore) {}
+
+  private key(): Promise<CryptoKey> {
+    this.wrappingKey ??= this.loadOrCreateKey().catch((error: unknown) => {
+      this.wrappingKey = undefined;
+      throw error;
+    });
+    return this.wrappingKey;
+  }
+  private async loadOrCreateKey(): Promise<CryptoKey> {
+    const existing = await this.store.legacy.get("kv", WRAPPING_KEY);
+    if (existing instanceof CryptoKey) return existing;
+    // Generate before opening IDB's transaction. The transaction then serializes creation across tabs.
+    const candidate = await crypto.subtle.generateKey({ name: "AES-GCM", length: 256 }, false, ["encrypt", "decrypt"]);
+    const transaction = this.store.legacy.transaction("kv", "readwrite");
+    const winner = await transaction.store.get(WRAPPING_KEY);
+    const key = winner instanceof CryptoKey ? winner : candidate;
+    if (!(winner instanceof CryptoKey)) await transaction.store.put(key, WRAPPING_KEY);
+    await transaction.done;
+    return key;
+  }
+  async getItem(key: string): Promise<string | null> {
+    const value = (await this.store.legacy.get("kv", entry(key))) as SealedValue | undefined;
+    if (!value) return null;
+    try {
+      if (value.version !== 1) return null;
+      return fromUtf8(new Uint8Array(await crypto.subtle.decrypt({ name: "AES-GCM", iv: copy(value.iv), additionalData: utf8(key) }, await this.key(), copy(value.ciphertext))));
+    } catch {
+      await this.removeItem(key);
+      return null;
+    }
+  }
+  async setItem(key: string, value: string): Promise<void> {
+    const iv = randomBytes(12);
+    const ciphertext = new Uint8Array(await crypto.subtle.encrypt({ name: "AES-GCM", iv, additionalData: utf8(key) }, await this.key(), utf8(value)));
+    await this.store.legacy.put("kv", { version: 1, iv, ciphertext } satisfies SealedValue, entry(key));
+  }
+  async removeItem(key: string): Promise<void> {
+    await this.store.legacy.delete("kv", entry(key));
+  }
+}
+
+export interface SupabasePublicConfig {
+  url: string;
+  publishableKey: string;
+  projectRef: string;
+}
+
+/** Construct only after staged account migration is enabled. Existing production auth stays on its released path. */
+export function createMeldiqSupabase(config: SupabasePublicConfig, store: LocalStore, options: { storageKey?: string; autoRefreshToken?: boolean } = {}): SupabaseClient {
+  const url = new URL(config.url);
+  if (url.protocol !== "https:" || url.hostname !== `${config.projectRef}.supabase.co` || url.pathname !== "/" || url.username || url.password || url.search || url.hash)
+    throw new Error("Invalid Supabase project origin");
+  if (!/^sb_publishable_[A-Za-z0-9_-]+$/.test(config.publishableKey)) throw new Error("Only a Supabase publishable key belongs in the client");
+  return createClient(url.origin, config.publishableKey, {
+    auth: {
+      storage: new EncryptedSupabaseStorage(store),
+      storageKey: options.storageKey ?? `meldiq-supabase:${config.projectRef}:${store.name}`,
+      persistSession: true,
+      autoRefreshToken: options.autoRefreshToken ?? true,
+      flowType: "pkce",
+      detectSessionInUrl: false,
+    },
+    global: {
+      fetch: (input, init) =>
+        fetch(input, {
+          ...init,
+          redirect: "error",
+          credentials: "omit",
+          cache: "no-store",
+          signal: init?.signal ? AbortSignal.any([init.signal, AbortSignal.timeout(20_000)]) : AbortSignal.timeout(20_000),
+        }),
+    },
+    realtime: { params: { eventsPerSecond: 10 } },
+  });
+}
diff --git a/src/auth/supabaseMigration.ts b/src/auth/supabaseMigration.ts
new file mode 100644
index 0000000..927d99a
--- /dev/null
+++ b/src/auth/supabaseMigration.ts
@@ -0,0 +1,164 @@
+/** Opt-in migration transport. It never changes device keys, offline state, stored legacy sessions or active UI auth. */
+export interface ProviderSession {
+  access_token: string;
+  user: { id: string };
+}
+export interface ExistingOwner {
+  accountId: string;
+  userId: string;
+  deviceId: string;
+}
+export interface PreparedAuthBinding extends ExistingOwner {
+  authUserId: string;
+  providerSessionId: string;
+}
+interface Options {
+  apiOrigin: string;
+  providerSession: ProviderSession;
+  expectedOwner: ExistingOwner;
+  /** Sign using the existing protected device key; never export or upload the key itself. */
+  signDeviceProof(message: string): Promise<string>;
+  totpCode?: string;
+  signal?: AbortSignal;
+  fetch?: typeof fetch;
+}
+const uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+const id = /^[A-Za-z0-9_-]{1,64}$/;
+const publicFailureCodes = new Set([
+  "unauthorized",
+  "invalid_credentials",
+  "fresh_auth_required",
+  "totp_required",
+  "totp_invalid",
+  "totp_locked",
+  "invalid_code",
+  "invalid_proof",
+  "device_revoked",
+  "account_disabled",
+  "session_expired",
+  "session_revoked",
+  "conflict",
+  "rate_limited",
+  "bad_request",
+  "unavailable",
+  "internal",
+  "device_required",
+]);
+export class AuthMigrationError extends Error {
+  constructor(
+    readonly code: string,
+    readonly status?: number,
+  ) {
+    super("Account migration could not be completed");
+    this.name = "AuthMigrationError";
+  }
+}
+
+function providerIdentity(provider: ProviderSession) {
+  try {
+    if (!uuid.test(provider.user.id) || provider.access_token.length > 16384) throw new Error();
+    const parts = provider.access_token.split(".");
+    if (parts.length !== 3) throw new Error();
+    const payload = parts[1].replace(/-/g, "+").replace(/_/g, "/");
+    const claims: unknown = JSON.parse(new TextDecoder().decode(Uint8Array.from(atob(payload + "=".repeat((4 - (payload.length % 4)) % 4)), (c) => c.charCodeAt(0))));
+    if (
+      !claims ||
+      typeof claims !== "object" ||
+      !("sub" in claims) ||
+      claims.sub !== provider.user.id ||
+      !("session_id" in claims) ||
+      typeof claims.session_id !== "string" ||
+      !uuid.test(claims.session_id)
+    )
+      throw new Error();
+    // Parsing supplies signature context only. The API verifies JWT signature, issuer, ownership and live state.
+    return { authUserId: provider.user.id, sessionId: claims.session_id };
+  } catch {
+    throw new AuthMigrationError("invalid_provider_session");
+  }
+}
+function transport(options: Options) {
+  let origin: URL;
+  try {
+    origin = new URL(options.apiOrigin);
+  } catch {
+    throw new AuthMigrationError("invalid_api_origin");
+  }
+  const loopback = ["localhost", "127.0.0.1", "[::1]"].includes(origin.hostname);
+  if ((origin.protocol !== "https:" && !(loopback && origin.protocol === "http:")) || origin.username || origin.password || origin.pathname !== "/" || origin.search || origin.hash)
+    throw new AuthMigrationError("invalid_api_origin");
+  const request = options.fetch ?? globalThis.fetch;
+  return async (method: "GET" | "POST" | "DELETE", route: string, body?: unknown): Promise<unknown> => {
+    const response = await request(`${origin.origin}${route}`, {
+      method,
+      redirect: "error",
+      credentials: "omit",
+      cache: "no-store",
+      signal: options.signal,
+      headers: { authorization: `Bearer ${options.providerSession.access_token}`, ...(body === undefined ? {} : { "content-type": "application/json" }) },
+      ...(body === undefined ? {} : { body: JSON.stringify(body) }),
+    });
+    if (!response.ok) {
+      let code = "migration_request_failed";
+      try {
+        const failure = (await response.json()) as { error?: { code?: unknown } };
+        if (typeof failure.error?.code === "string" && publicFailureCodes.has(failure.error.code)) code = failure.error.code;
+      } catch {
+        /* Never include server response bodies or credentials in error messages. */
+      }
+      throw new AuthMigrationError(code, response.status);
+    }
+    try {
+      return await response.json();
+    } catch {
+      throw new AuthMigrationError("invalid_server_response");
+    }
+  };
+}
+async function prepare(options: Options, legacy?: { accessToken: string; password?: string }): Promise<PreparedAuthBinding> {
+  const session = { access_token: options.providerSession.access_token, user: { id: options.providerSession.user.id } };
+  const identity = providerIdentity(session);
+  if (![options.expectedOwner.accountId, options.expectedOwner.userId, options.expectedOwner.deviceId].every((value) => typeof value === "string" && id.test(value)))
+    throw new AuthMigrationError("invalid_existing_owner");
+  if (legacy && (legacy.accessToken.length < 20 || legacy.accessToken.length > 200)) throw new AuthMigrationError("invalid_legacy_session");
+  const request = transport({ ...options, providerSession: session });
+  const challenge = (await request("POST", "/v1/auth/challenge")) as { nonce?: unknown; expiresAt?: unknown };
+  if (
+    !challenge ||
+    typeof challenge.nonce !== "string" ||
+    !/^[A-Za-z0-9_-]{16,128}$/.test(challenge.nonce) ||
+    typeof challenge.expiresAt !== "number" ||
+    !Number.isSafeInteger(challenge.expiresAt) ||
+    challenge.expiresAt <= Date.now()
+  )
+    throw new AuthMigrationError("invalid_device_challenge");
+  const signature = await options.signDeviceProof(`meldiq-supabase-device-v1\n${identity.authUserId}\n${identity.sessionId}\n${options.expectedOwner.deviceId}\n${challenge.nonce}`);
+  if (!/^[A-Za-z0-9+/]{86}==$/.test(signature)) throw new AuthMigrationError("invalid_device_signature");
+  const bound = (await request("POST", legacy ? "/v3/auth/legacy-link" : "/v3/auth/device", {
+    deviceId: options.expectedOwner.deviceId,
+    nonce: challenge.nonce,
+    signature,
+    ...(options.totpCode ? { totpCode: options.totpCode } : {}),
+    ...(legacy ? { legacyAccessToken: legacy.accessToken, ...(legacy.password ? { password: legacy.password } : {}) } : {}),
+  })) as { ok?: unknown };
+  if (!bound || bound.ok !== true) throw new AuthMigrationError("invalid_server_response");
+  const owner = (await request("GET", "/v3/auth/me")) as { authUserId?: unknown; accountId?: unknown; userId?: unknown };
+  if (!owner || owner.authUserId !== identity.authUserId || owner.accountId !== options.expectedOwner.accountId || owner.userId !== options.expectedOwner.userId)
+    throw new AuthMigrationError("identity_mismatch");
+  return {
+    accountId: options.expectedOwner.accountId,
+    userId: options.expectedOwner.userId,
+    deviceId: options.expectedOwner.deviceId,
+    authUserId: identity.authUserId,
+    providerSessionId: identity.sessionId,
+  };
+}
+
+/** Return a verified binding receipt. The caller must fence the current SDK session before switching API auth. */
+export function prepareLegacySupabaseLink(options: Options & { legacyAccessToken: string; password?: string }): Promise<PreparedAuthBinding> {
+  return prepare(options, { accessToken: options.legacyAccessToken, password: options.password });
+}
+/** A later provider login can authorize only an already-certified device of its explicitly mapped owner. */
+export function prepareSupabaseDevice(options: Options): Promise<PreparedAuthBinding> {
+  return prepare(options);
+}
diff --git a/src/auth/supabasePreview.ts b/src/auth/supabasePreview.ts
new file mode 100644
index 0000000..665c150
--- /dev/null
+++ b/src/auth/supabasePreview.ts
@@ -0,0 +1,122 @@
+import type { SupabaseClient } from "@supabase/supabase-js";
+import type { LocalStore } from "../store/db";
+import { createMeldiqSupabase, EncryptedSupabaseStorage } from "./supabaseClient";
+import { AuthMigrationError, prepareLegacySupabaseLink, type ExistingOwner, type PreparedAuthBinding } from "./supabaseMigration";
+import type { SupabasePreviewConfig } from "./supabasePreviewConfig";
+
+interface PreviewOptions {
+  provider: SupabasePreviewConfig;
+  store: LocalStore;
+  apiOrigin: string;
+  owner: ExistingOwner;
+  legacyAccessToken: string;
+  email: string;
+  password: string;
+  legacyPassword?: string;
+  totpCode?: string;
+  signal?: AbortSignal;
+  isCurrentOwner(): boolean;
+  signDeviceProof(message: string): Promise<string>;
+}
+interface PreviewDependencies {
+  client?: (key: string) => SupabaseClient;
+  fetch?: typeof fetch;
+}
+
+/** A staging-only rehearsal. It never adopts a new API bearer, starts Realtime or touches legacy/offline data. */
+export async function checkSupabaseSignIn(options: PreviewOptions, dependencies: PreviewDependencies = {}): Promise<PreparedAuthBinding> {
+  if (!/^[^\s@]+@example\.(?:test|invalid)$/i.test(options.email)) throw new AuthMigrationError("synthetic_account_required");
+  const guard = () => {
+    if (options.signal?.aborted || !options.isCurrentOwner()) throw new AuthMigrationError("preview_cancelled");
+  };
+  guard();
+  const origin = new URL(options.apiOrigin);
+  if (
+    origin.username ||
+    origin.password ||
+    origin.pathname !== "/" ||
+    origin.search ||
+    origin.hash ||
+    (origin.protocol !== "https:" && !(origin.protocol === "http:" && ["localhost", "127.0.0.1", "[::1]"].includes(origin.hostname)))
+  )
+    throw new AuthMigrationError("invalid_api_origin");
+  const key = `meldiq-supabase-preview:${crypto.randomUUID()}`;
+  const storage = new EncryptedSupabaseStorage(options.store);
+  const client = dependencies.client?.(key) ?? createMeldiqSupabase(options.provider, options.store, { storageKey: key, autoRefreshToken: false });
+  const request = dependencies.fetch ?? globalThis.fetch;
+  let token: string | undefined,
+    linked = false;
+  const revoke = async () => {
+    if (!token || !linked) return;
+    const response = await request(`${origin.origin}/v3/auth/session`, {
+      method: "DELETE",
+      headers: { authorization: `Bearer ${token}` },
+      credentials: "omit",
+      cache: "no-store",
+      redirect: "error",
+      signal: AbortSignal.timeout(10_000),
+    });
+    if (!response.ok && response.status !== 401) throw new AuthMigrationError("preview_cleanup_failed");
+  };
+  let result: PreparedAuthBinding | undefined;
+  let failure: unknown;
+  try {
+    const signedIn = await client.auth.signInWithPassword({ email: options.email, password: options.password });
+    if (signedIn.error || !signedIn.data.session) throw new AuthMigrationError("provider_sign_in_failed");
+    const session = signedIn.data.session;
+    token = session.access_token;
+    guard();
+    const receipt = await prepareLegacySupabaseLink({
+      apiOrigin: origin.origin,
+      providerSession: session,
+      expectedOwner: { ...options.owner },
+      legacyAccessToken: options.legacyAccessToken,
+      password: options.legacyPassword,
+      totpCode: options.totpCode,
+      signal: options.signal,
+      fetch: request,
+      signDeviceProof: async (message) => {
+        guard();
+        const signed = await options.signDeviceProof(message);
+        guard();
+        return signed;
+      },
+    });
+    linked = true;
+    guard();
+    const current = await client.auth.getSession();
+    if (current.error || current.data.session?.access_token !== token || current.data.session.user.id !== receipt.authUserId) throw new AuthMigrationError("provider_session_changed");
+    result = receipt;
+  } catch (error) {
+    failure = error instanceof AuthMigrationError ? error : new AuthMigrationError("preview_failed");
+  }
+  // Even after cancellation, end this isolated test session. Cleanup uses its own bounded signal.
+  let cleanupFailed = false;
+  try {
+    await revoke();
+  } catch {
+    cleanupFailed = true;
+  }
+  try {
+    if ((await client.auth.signOut({ scope: "local" })).error) cleanupFailed = true;
+  } catch {
+    cleanupFailed = true;
+  }
+  try {
+    await client.auth.dispose();
+    client.realtime.disconnect();
+  } catch {
+    cleanupFailed = true;
+  }
+  for (const entry of [key, `${key}-user`, `${key}-code-verifier`]) {
+    try {
+      await storage.removeItem(entry);
+    } catch {
+      cleanupFailed = true;
+    }
+  }
+  if (cleanupFailed) throw new AuthMigrationError("preview_cleanup_failed");
+  if (failure) throw failure;
+  guard();
+  return result!;
+}
