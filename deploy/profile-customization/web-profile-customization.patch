diff --git a/test/legacy-profile-compatibility.test.ts b/test/legacy-profile-compatibility.test.ts
new file mode 100644
index 0000000..aaa818d
--- /dev/null
+++ b/test/legacy-profile-compatibility.test.ts
@@ -0,0 +1,14 @@
+import { expect, it } from "vitest";
+import { zProfileStyle as releasedProfileStyle } from "./support/legacy-web-426/profileSchemas";
+import { readCopy } from "./support/contracts";
+
+it("the deployed web reader keeps legacy fallbacks when a profile contains collectible descriptors", () => {
+  const response = readCopy<{ profileStyle: Record<string, unknown> }>("http/PATCH_v2_users_me_profile-customization.json");
+  expect(response.profileStyle.collectibles).toBeInstanceOf(Array);
+  const legacy = releasedProfileStyle.parse(response.profileStyle);
+  expect(legacy).not.toBeNull();
+  expect(legacy).not.toHaveProperty("collectibles");
+  expect(legacy?.decoration).toBe(response.profileStyle.decoration);
+  expect(legacy?.accent).toBe(response.profileStyle.accent);
+  expect(legacy?.nameFont).toBe(response.profileStyle.nameFont);
+});
diff --git a/test/profile-collectibles.test.ts b/test/profile-collectibles.test.ts
new file mode 100644
index 0000000..f9a89e9
--- /dev/null
+++ b/test/profile-collectibles.test.ts
@@ -0,0 +1,57 @@
+import { describe, expect, it } from "vitest";
+import { zCollectible, zCollectibleLook } from "../src/api/collectibleSchemas";
+import { zProfileStyle } from "../src/api/profileSchemas";
+import { previewCollectible, previewLegacyStyle } from "../src/sync/collectibles";
+import { NO_STYLE } from "../src/ui/settings/noStyle";
+import { recipeBackground, collectibleCardVars } from "../src/ui/people/CollectibleLayers";
+const item = zCollectible.parse({
+  id: "ion-halo",
+  name: "Ion Halo",
+  category: "avatar-frame",
+  version: 1,
+  recipe: { colors: ["#22d3ee", "#6366f1"], pattern: "orbit", frame: "aurora" },
+  description: "Original Meldiq artwork",
+  rarity: "common",
+  acquisitionType: "free",
+  price: 0,
+  currency: "USD",
+  isActive: true,
+  isFeatured: true,
+  availableFrom: null,
+  availableUntil: null,
+  supportedPlatforms: ["web", "android", "windows", "macos"],
+});
+describe("profile collectible rendering and draft safety", () => {
+  it("previews a slot without changing the saved profile or unrelated styles", () => {
+    const saved = { ...NO_STYLE, nameFont: "mono" as const, tagOrgId: "community" };
