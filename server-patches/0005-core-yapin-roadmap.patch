index 0000000..16e43ca
--- /dev/null
+++ b/server/migrations/078_community_profiles.sql
@@ -0,0 +1,10 @@
+-- Community identity choices follow membership and never alter the global profile.
+CREATE TABLE community_profiles (
+  org_id TEXT NOT NULL,
+  user_id TEXT NOT NULL,
+  profile TEXT NOT NULL,
+  rev INTEGER NOT NULL DEFAULT 1,
+  updated_at INTEGER NOT NULL,
+  PRIMARY KEY (org_id,user_id),
+  FOREIGN KEY (org_id,user_id) REFERENCES org_members(org_id,user_id) ON DELETE CASCADE
+);
diff --git a/server/migrations/079_bot_runtime_events.sql b/server/migrations/079_bot_runtime_events.sql
new file mode 100644
index 0000000..88a621f
--- /dev/null
+++ b/server/migrations/079_bot_runtime_events.sql
@@ -0,0 +1,10 @@
+-- Bounded metadata-only execution history for community bot administrators.
+CREATE TABLE bot_runtime_events (
+  id TEXT PRIMARY KEY,
+  org_id TEXT NOT NULL REFERENCES orgs(id) ON DELETE CASCADE,
+  bot_key TEXT NOT NULL,
+  kind TEXT NOT NULL,
+  outcome TEXT NOT NULL CHECK(outcome IN ('ok','failed')),
+  at INTEGER NOT NULL
+);
+CREATE INDEX idx_bot_runtime_events_scope ON bot_runtime_events(org_id,bot_key,at DESC,id DESC);
