+  AdminPermissionView,
+  AdminReportDetail,
+  AdminReportParams,
+  AdminReportQuery,
+  AdminReportsPage,
+  AdminReportUpdate,
+} from "../platformAdmin.js";
+const base = { tag: "Central administration", auth: true, scheme: "console", requires: "admin_console" } as const;
+export const adminOperationsRoutes: readonly RouteContract[] = [
+  route({
+    ...base,
+    method: "DELETE",
+    url: "/admin/v1/orgs/:orgId",
+    summary: "Super admin and passkey: permanently delete an already suspended, unsubscribed community through the existing idempotent deletion workflow.",
+    params: AdminOrgParams,
+    body: AdminOrgDeleteBody,
+    response: AdminOrgDeleted,
+  }),
+  route({ ...base, method: "GET", url: "/admin/v1/reports", summary: "reports.view: metadata-only report queue with stable keyset pagination.", query: AdminReportQuery, response: AdminReportsPage }),
+  route({ ...base, method: "GET", url: "/admin/v1/reports/assignees", summary: "reports.manage: active administrators eligible for report assignment.", response: AdminAssignees }),
+  route({
+    ...base,
+    method: "GET",
+    url: "/admin/v1/reports/:reportId",
+    summary: "reports.view: report metadata and latest 100 internal workflow events.",
+    params: AdminReportParams,
+    response: AdminReportDetail,
+  }),
+  route({
+    ...base,
+    method: "PATCH",
+    url: "/admin/v1/reports/:reportId",
+    summary: "reports.manage and passkey: assign, prioritize, note, resolve or record an appeal with optimistic version control.",
+    params: AdminReportParams,
+    body: AdminReportUpdate,
+    response: AdminReportDetail,
+  }),
+  route({
+    ...base,
+    method: "GET",
+    url: "/admin/v1/admins/:accountId/permissions",
+    summary: "admins.view: role defaults and effective per-admin allowlist.",
+    params: AdminAccountParams,
+    response: AdminPermissionView,
+  }),
+  route({
+    ...base,
+    method: "PUT",
+    url: "/admin/v1/admins/:accountId/permissions",
+    summary: "admins.manage and passkey: restrict another non-owner grant and revoke its sessions. Null restores role defaults.",
+    params: AdminAccountParams,
+    body: AdminPermissionUpdate,
+    response: AdminPermissionView,
+  }),
+  route({
+    ...base,
+    method: "POST",
+    url: "/admin/v1/orgs/:orgId/restriction",
+    summary: "orgs.restrict and passkey: suspend or restore shared community authorization without deleting memberships.",
+    params: AdminOrgParams,
+    body: AdminOrgRestriction,
+    response: AdminOrgDetail,
+  }),
+];
