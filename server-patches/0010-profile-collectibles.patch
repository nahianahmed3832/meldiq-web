+          await fetch(signed.upload.url, {
+            method: "PUT",
+            headers: signed.upload.headers,
+            body,
+          })
+        ).status,
+      ).toBe(412);
+      const unsigned = new URL(signed.upload.url);
+      unsigned.search = "";
