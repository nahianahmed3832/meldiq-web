+import { createRemoteJWKSet, jwtVerify, type JWTVerifyGetKey } from "jose";
+import type { MeldiqPostgres } from "./client.js";
+
+export interface SupabasePrincipal { authUserId: string; accountId: string; userId: string; sessionId: string; }
+export interface SupabaseSession { authUserId: string; sessionId: string; }
+const uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+
+/** Supabase identity never replaces Meldiq's existing device proof or platform-admin authorization. */
+export class SupabaseAccessVerifier {
+  private readonly keys: JWTVerifyGetKey;
+  private readonly issuer: string;
+  constructor(projectUrl: string, private readonly db: MeldiqPostgres, keys?: JWTVerifyGetKey) {
+    const url = new URL(projectUrl);
+    if (url.protocol !== "https:" || url.username || url.password || url.search || url.hash || url.pathname !== "/") throw new Error("Trusted HTTPS Supabase project origin required");
+    this.issuer = `${url.origin}/auth/v1`;
+    this.keys = keys ?? createRemoteJWKSet(new URL(`${this.issuer}/.well-known/jwks.json`), { timeoutDuration: 5000, cooldownDuration: 30_000 });
+  }
+  private async claims(token: string): Promise<SupabaseSession | null> {
+    if (token.length > 16_384) return null;
+    let claims;
+    try {
+      ({ payload: claims } = await jwtVerify(token, this.keys, { issuer: this.issuer, audience: "authenticated", algorithms: ["ES256", "RS256"],
+        requiredClaims: ["sub", "exp", "iat", "session_id", "role"], clockTolerance: 5 }));
+    } catch { return null; }
+    if (!claims.sub || !uuid.test(claims.sub) || typeof claims.session_id !== "string" || !uuid.test(claims.session_id)
+      || claims.role !== "authenticated" || typeof claims.iat !== "number" || claims.iat > Date.now()/1000+5) return null;
+    return {authUserId: claims.sub, sessionId: claims.session_id};
+  }
+  /** A valid provider session before an internal account has been explicitly linked. No email ownership inference. */
+  async verifySession(token: string): Promise<SupabaseSession | null> {
+    const session = await this.claims(token);
+    if (!session) return null;
+    const result = await this.db.query<{active: boolean}>("SELECT meldiq_private.session_active($1::uuid,$2::uuid) AS active", [session.authUserId, session.sessionId]);
+    return result.rows[0].active ? session : null;
+  }
+  async verify(token: string): Promise<SupabasePrincipal | null> {
+    const session = await this.claims(token);
+    return session ? this.resolveSession(session) : null;
+  }
+  /** For a socket already bound by a verified JWT; this never authenticates arbitrary request identifiers. */
+  async resolveSession(session: SupabaseSession): Promise<SupabasePrincipal | null> {
+    if (!uuid.test(session.authUserId) || !uuid.test(session.sessionId)) return null;
+    // Ownership and revocation remain database checks, never mutable JWT user_metadata.
+    const result = await this.db.query<{ account_id: string; user_id: string }>(`
+      SELECT l.account_id, l.user_id FROM meldiq_private.auth_links l
+      JOIN meldiq.accounts a ON a.id = l.account_id AND a.user_id = l.user_id
+      JOIN meldiq.users u ON u.id = l.user_id
+      WHERE l.auth_user_id = $1 AND a.disabled_at IS NULL AND u.disabled_at IS NULL AND u.deleted_at IS NULL
+        AND meldiq_private.session_active($1::uuid, $2::uuid)`, [session.authUserId, session.sessionId]);
+    const owner = result.rows[0];
+    return owner ? {...session, accountId: owner.account_id, userId: owner.user_id} : null;
+  }
+}
diff --git a/server/src/infrastructure/database/postgres/client.ts b/server/src/infrastructure/database/postgres/client.ts
new file mode 100644
index 00000000..c36d30bb
--- /dev/null
+++ b/server/src/infrastructure/database/postgres/client.ts
@@ -0,0 +1,93 @@
+import { AsyncLocalStorage } from "node:async_hooks";
+import pg, { type PoolClient, type QueryResultRow } from "pg";
+
+export interface PostgresConfig {
+  url: string;
+  environment: "development" | "staging" | "production";
+  /** Required by the staged application bootstrap for remote project identity checks. */
+  projectRef?: string;
+  maxConnections?: number;
+  ca?: string;
+}
+
+/** Explicit per-pool decoding: never silently round money, counters or epoch milliseconds. */
+export const safeTypes = {
+  getTypeParser(oid: number, format?: string) {
+    if (oid === 1016 && format !== "binary") return (value: string) => (pg.types.getTypeParser(1016 as Parameters<typeof pg.types.getTypeParser>[0])(value) as string[]).map(item => {
+      const number = Number(item); if (!Number.isSafeInteger(number)) throw new Error("PostgreSQL integer array exceeds safe range"); return number;
+    });
+    if (oid === 20 && format !== "binary") return (value: string) => {
+      const number = Number(value);
+      if (!Number.isSafeInteger(number)) throw new Error("PostgreSQL integer exceeds the API's safe range");
+      return number;
+    };
+    return pg.types.getTypeParser(oid, format as "text");
+  },
+};
+
+export class MeldiqPostgres {
+  readonly pool: pg.Pool;
+  private readonly context = new AsyncLocalStorage<PoolClient>();
+  private runtimeGuard?: () => void;
+
+  constructor(readonly config: PostgresConfig) {
+    const url = new URL(config.url);
+    if (!["postgres:", "postgresql:"].includes(url.protocol)) throw new Error("PostgreSQL URL required");
+    const local = ["localhost", "127.0.0.1", "[::1]"].includes(url.hostname);
+    if (config.environment === "production" && local) throw new Error("Production cannot use a development database");
+    if ([...url.searchParams.keys()].some(k => /^ssl/i.test(k))) throw new Error("Configure TLS through the trusted CA setting, not URL overrides");
+    const max = config.maxConnections ?? 5;
+    if (!Number.isInteger(max) || max < 1 || max > 20) throw new Error("Connection pool must be between 1 and 20");
+    this.pool = new pg.Pool({ connectionString: url.href, max, min: 0, idleTimeoutMillis: 30_000,
+      connectionTimeoutMillis: 5_000, statement_timeout: 15_000, idle_in_transaction_session_timeout: 30_000,
+      application_name: `meldiq-${config.environment}`, options: "-c timezone=UTC",
+      ssl: local ? false : { rejectUnauthorized: true, ...(config.ca ? { ca: config.ca } : {}) }, types: safeTypes });
+    // No raw driver errors: connection errors can contain infrastructure details.
+    this.pool.on("error", () => { this.connectionErrors++; });
+  }
+  connectionErrors = 0;
+
+  async query<R extends QueryResultRow = QueryResultRow>(sql: string, values: unknown[] = []) {
+    this.runtimeGuard?.();
+    return (this.context.getStore() ?? this.pool).query<R>(sql, values);
+  }
+
+  /** No automatic callback retries: callers may have performed non-transactional external work. */
+  async transaction<T>(run: (client: PoolClient) => Promise<T>): Promise<T> {
+    this.runtimeGuard?.();
+    const current = this.context.getStore();
+    if (current) throw new Error("Nested PostgreSQL transactions require an explicit service boundary");
+    const client = await this.pool.connect();
+    let discard = false;
+    try {
+      await client.query("BEGIN");
+      const result = await this.context.run(client, () => run(client));
+      await client.query("COMMIT");
+      return result;
+    } catch (error) {
+      try { await client.query("ROLLBACK"); } catch { discard = true; }
+      throw error;
+    } finally { client.release(discard); }
+  }
+
+  async asUser<T>(subject: string, sessionId: string, run: () => Promise<T>): Promise<T> {
+    return this.transaction(async client => {
+      await client.query("SET LOCAL ROLE authenticated");
+      await client.query("SELECT set_config('request.jwt.claims', $1, true)", [JSON.stringify({ sub: subject, session_id: sessionId, role: "authenticated" })]);
+      return run();
+    });
+  }
+
+  metrics() { return { total: this.pool.totalCount, idle: this.pool.idleCount, waiting: this.pool.waitingCount, errors: this.connectionErrors }; }
+  installRuntimeGuard(guard: () => void): () => void {
+    if (this.runtimeGuard) throw new Error("A PostgreSQL application runtime is already attached");
+    this.runtimeGuard = guard;
+    return () => { if (this.runtimeGuard === guard) this.runtimeGuard = undefined; };
+  }
+  async close() { await this.pool.end(); }
+}
+
+export function identifier(value: string): string {
+  if (!/^[a-z_][a-z0-9_]*$/.test(value)) throw new Error("Invalid schema identifier");
+  return `"${value}"`;
+}
diff --git a/server/src/infrastructure/database/postgres/documents.ts b/server/src/infrastructure/database/postgres/documents.ts
new file mode 100644
index 00000000..11417c8e
--- /dev/null
+++ b/server/src/infrastructure/database/postgres/documents.ts
@@ -0,0 +1,40 @@
+import { DuplicateDocument, type DocumentStore, type Keyed, type Match, type FindOptions } from "../documents.js";
+import { NATIVE_TABLES } from "./nativeCatalog.js";
+import { identifier as q, type MeldiqPostgres } from "./client.js";
+import type { TableSpec } from "../mongo/catalog.js";
+
+const snake=(s:string)=>s.replace(/[A-Z]/g,c=>`_${c.toLowerCase()}`);
+const camel=(s:string)=>s.replace(/_([a-z])/g,(_,c:string)=>c.toUpperCase());
+
+/** Whitelisted relational implementation of the existing atomic keyed-store contract. */
+export class PostgresDocuments<T extends Keyed> implements DocumentStore<T>{
+  readonly backend="postgres" as const;
+  private readonly spec:TableSpec;
+  constructor(private readonly db:MeldiqPostgres,private readonly collection:string){
+    const spec=NATIVE_TABLES.find(t=>t.name===collection);if(!spec)throw new Error("Unknown PostgreSQL document relation");this.spec=spec;
+  }
+  private field(key:string){const name=snake(key);if(!this.spec.columns.some(c=>c.name===name))throw new Error("Unmapped document field");return q(name);}
+  private values(doc:Partial<T>){return Object.entries(doc).filter(([,v])=>v!==undefined).map(([k,v])=>{this.field(k);const col=this.spec.columns.find(c=>c.name===snake(k))!;return[k,col.type==="JSONB"?JSON.stringify(v):v] as const;});}
+  private decode(row:Record<string,unknown>):T{return Object.fromEntries(Object.entries(row).map(([k,v])=>[camel(k),v])) as unknown as T;}
+  private predicate(match:Match<T>,values:unknown[]){const keys=Object.entries(match);return keys.map(([k,v])=>{const col=this.field(k);if(v===null)return`${col} IS NULL`;values.push(v);return`${col}=$${values.length}`;}).join(" AND ")||"true";}
+  async insert(doc:T){const fields=this.values(doc);try{await this.db.query(`INSERT INTO meldiq.${q(this.collection)} (${fields.map(([k])=>this.field(k))}) VALUES (${fields.map((_,i)=>`$${i+1}`)})`,fields.map(([,v])=>v));}catch(error){if((error as {code?:string}).code==="23505")throw new DuplicateDocument("Duplicate document");throw error;}}
+  async put(doc:T){const fields=this.values(doc);await this.db.query(`INSERT INTO meldiq.${q(this.collection)} (${fields.map(([k])=>this.field(k))}) VALUES (${fields.map((_,i)=>`$${i+1}`)}) ON CONFLICT(id) DO UPDATE SET ${fields.filter(([k])=>k!=="id").map(([k])=>`${this.field(k)}=excluded.${this.field(k)}`).join(",")}`,fields.map(([,v])=>v));}
+  async get(id:string):Promise<T|null>{return(await this.find({id} as Match<T>,{limit:1}))[0]??null;}
+  async find(match:Match<T>,opts:FindOptions<T>={}):Promise<T[]>{
+    const values:unknown[]=[];let where=this.predicate(match,values),order="";
+    if(opts.newestBy){const col=this.field(opts.newestBy);if(opts.before!==undefined){values.push(opts.before);where+=` AND ${col}<$${values.length}`;}order=` ORDER BY ${col} DESC,id DESC`;}
+    if(opts.limit!==undefined&&(!Number.isInteger(opts.limit)||opts.limit<0||opts.limit>10000))throw new Error("Invalid document page size");
+    const limit=opts.limit===undefined?"":` LIMIT ${opts.limit}`;
+    return(await this.db.query(`SELECT * FROM meldiq.${q(this.collection)} WHERE ${where}${order}${limit}`,values)).rows.map(r=>this.decode(r));
+  }
+  async count(match:Match<T>){const values:unknown[]=[];const where=this.predicate(match,values);return(await this.db.query(`SELECT count(*) AS n FROM meldiq.${q(this.collection)} WHERE ${where}`,values)).rows[0].n as number;}
+  async update(id:string,where:Match<T>,change:Partial<T>):Promise<T|null>{
+    const fields=this.values(change).filter(([k])=>k!=="id");if(!fields.length)return(await this.find({...where,id} as Match<T>,{limit:1}))[0]??null;
+    const values:unknown[]=fields.map(([,v])=>v),predicate=this.predicate({...where,id} as Match<T>,values);
+    const result=await this.db.query(`UPDATE meldiq.${q(this.collection)} SET ${fields.map(([k],i)=>`${this.field(k)}=$${i+1}`)} WHERE ${predicate} RETURNING *`,values);
+    return result.rows[0]?this.decode(result.rows[0]):null;
+  }
+  async take(id:string,where:Match<T>={}):Promise<T|null>{const values:unknown[]=[];const predicate=this.predicate({...where,id} as Match<T>,values);const result=await this.db.query(`DELETE FROM meldiq.${q(this.collection)} WHERE ${predicate} RETURNING *`,values);return result.rows[0]?this.decode(result.rows[0]):null;}
+  async deleteMany(match:Match<T>){const values:unknown[]=[];const predicate=this.predicate(match,values);return(await this.db.query(`DELETE FROM meldiq.${q(this.collection)} WHERE ${predicate}`,values)).rowCount??0;}
+  async deleteBelow(field:keyof T&string,value:number){return(await this.db.query(`DELETE FROM meldiq.${q(this.collection)} WHERE ${this.field(field)}<$1`,[value])).rowCount??0;}
+}
diff --git a/server/src/infrastructure/database/postgres/migration.ts b/server/src/infrastructure/database/postgres/migration.ts
new file mode 100644
index 00000000..524383df
--- /dev/null
+++ b/server/src/infrastructure/database/postgres/migration.ts
@@ -0,0 +1,118 @@
+import crypto from "node:crypto";
+import type { TableSpec } from "../mongo/catalog.js";
+import type { Row } from "../rows/types.js";
+import { identifier as q, type MeldiqPostgres } from "./client.js";
+
+export const digest = (value: string) => crypto.createHash("sha256").update(value).digest("hex");
+function canonical(value: unknown): unknown {
+  if (Buffer.isBuffer(value) || value instanceof Uint8Array) return { $binary: Buffer.from(value).toString("base64") };
+  if (Array.isArray(value)) return value.map(canonical);
+  if (value && typeof value === "object") return Object.fromEntries(Object.entries(value).sort(([a],[b])=>a<b?-1:a>b?1:0).map(([k,v])=>[k,canonical(v)]));
+  return value;
+}
+export const rowHash = (row: Row) => digest(JSON.stringify(canonical(row)));
+
+/** One database round trip for a whole catalog, including empty relations. */
+export async function tableCounts(db:MeldiqPostgres,specs:readonly TableSpec[]):Promise<Map<string,number>> {
+  const sql=specs.map((spec,i)=>`SELECT $${i+1}::text AS name,count(*) AS count FROM meldiq.${q(spec.name)}`).join(" UNION ALL ");
+  const result=await db.query<{name:string;count:number}>(sql,specs.map(t=>t.name));
+  return new Map(result.rows.map(row=>[row.name,row.count]));
+}
+
+export function validateRow(spec: TableSpec, input: Row): Row {
+  const allowed = [...spec.columns, ...(!spec.primaryKey.length ? [{name:"rowid",type:"INTEGER",notNull:true}] : [])];
+  if (Object.keys(input).some(k=>!allowed.some(c=>c.name===k))) throw new Error("Unmapped source column");
+  const row: Row = {};
+  for (const column of allowed) {
+    const value = input[column.name];
+    if (value === undefined) throw new Error("Missing source column");
+    if (value === null) {
+      if (column.notNull || spec.primaryKey.includes(column.name)) throw new Error("Required source value is null");
+      row[column.name] = null; continue;
+    }
+    if (column.type === "TEXT" && typeof value !== "string") throw new Error("Source text type mismatch");
+    if (column.type === "INTEGER" && (typeof value !== "number" || !Number.isSafeInteger(value))) throw new Error("Unsafe source integer");
+    if (column.type === "REAL" && (typeof value !== "number" || !Number.isFinite(value))) throw new Error("Invalid source real");
+    if (column.type === "BOOLEAN" && typeof value !== "boolean") throw new Error("Invalid source boolean");
+    if (column.type === "TEXT[]" && (!Array.isArray(value) || value.some(v=>typeof v!=="string"))) throw new Error("Invalid source text array");
+    if (column.type === "BIGINT[]" && (!Array.isArray(value) || value.some(v=>typeof v!=="number" || !Number.isSafeInteger(v)))) throw new Error("Invalid source integer array");
+    if (column.type === "JSONB" && (typeof value!=="object" || value===null)) throw new Error("Invalid source JSON document");
+    if (column.type === "BLOB") {
+      if (value && typeof value === "object" && "$binary" in value && typeof value.$binary === "string") row[column.name] = Buffer.from(value.$binary,"base64");
+      else if (Buffer.isBuffer(value) || value instanceof Uint8Array) row[column.name] = Buffer.from(value);
+      else throw new Error("Invalid source binary");
+    } else row[column.name] = value;
+  }
+  return row;
+}
+
+export function dependencyOrder(specs: readonly TableSpec[]): TableSpec[] {
+  const remaining = new Map(specs.map(t=>[t.name,t]));
+  const done = new Set<string>(); const ordered: TableSpec[] = [];
+  while (remaining.size) {
+    const ready = [...remaining.values()].filter(t=>t.foreignKeys.every(f=>done.has(f.table)));
+    if (!ready.length) throw new Error("Missing or cyclic migration dependency requires an explicit plan");
+    for (const table of ready.sort((a,b)=>a.name.localeCompare(b.name))) {ordered.push(table);done.add(table.name);remaining.delete(table.name);}
+  }
+  return ordered;
+}
+
+export interface MigrationRun { id: string; sourceSha256: string; catalogSha256: string; environment: "development" | "staging"; }
+/** Strict immutable snapshot import. Conflicting existing rows are never overwritten.
+ * A batch checkpoint and its rows commit together; a changed batch cannot reuse a checkpoint.
+ */
+export class TypedPostgresImporter {
+  constructor(private readonly db: MeldiqPostgres) {}
+  async start(run: MigrationRun) {
+    if (this.db.config.environment === "production") throw new Error("Production imports require a separately approved cutover release");
+    await this.db.query(`INSERT INTO meldiq_private.migration_runs(id,source_sha256,catalog_sha256,environment) VALUES($1,$2,$3,$4) ON CONFLICT(id) DO NOTHING`,[run.id,run.sourceSha256,run.catalogSha256,run.environment]);
+    const previous = (await this.db.query("SELECT * FROM meldiq_private.migration_runs WHERE id=$1",[run.id])).rows[0];
+    if (previous.source_sha256!==run.sourceSha256 || previous.catalog_sha256!==run.catalogSha256 || previous.environment!==run.environment) throw new Error("Migration run source changed");
+  }
+  async batch(runId: string, spec: TableSpec, number: number, input: Row[]): Promise<{inserted:number;resumed:boolean;sha256:string}> {
+    if (this.db.config.environment === "production") throw new Error("Production import disabled");
+    if (!Number.isSafeInteger(number) || number<0 || input.length>500) throw new Error("Invalid migration batch");
+    const rows=input.map(r=>validateRow(spec,r));
+    const sha256=digest(rows.map(rowHash).join("\n"));
+    return this.db.transaction(async()=>{
+      // Prevent an operator import racing the synchronous runtime's cached writer.
+      const lock=(await this.db.query("SELECT pg_try_advisory_xact_lock(hashtextextended('meldiq-rows-writer',0)) AS ok")).rows[0].ok;
+      if(!lock) throw new Error("Stop the repository writer before importing");
+      const previous=(await this.db.query("SELECT * FROM meldiq_private.migration_batches WHERE run_id=$1 AND table_name=$2 AND batch_number=$3",[runId,spec.name,number])).rows[0];
+      if (previous) {
+        if(previous.sha256!==sha256 || previous.record_count!==rows.length) throw new Error("Completed batch source changed");
+        await this.compareRows(spec,rows);
+        return {inserted:0,resumed:true,sha256};
+      }
+      const columns=[...spec.columns.map(c=>c.name),...(!spec.primaryKey.length?["rowid"]:[])];
+      let inserted=0;
+      if(rows.length) {
+        if(rows.length*columns.length>60000)throw new Error("Migration batch exceeds parameter budget");
+        const values=rows.flatMap(row=>columns.map(c=>row[c]));
+        const groups=rows.map((_,n)=>`(${columns.map((_,i)=>`$${n*columns.length+i+1}`).join(",")})`).join(",");
+        const result=await this.db.query(`INSERT INTO meldiq.${q(spec.name)} (${columns.map(q)}) VALUES ${groups} ON CONFLICT DO NOTHING`,values);
+        inserted=result.rowCount??0;
+      }
+      await this.compareRows(spec,rows);
+      const counter=spec.autoincrement?spec.primaryKey[0]:!spec.primaryKey.length?"rowid":null;
+      if(counter && rows.length) await this.db.query("INSERT INTO meldiq_private.row_counters(table_name,value) VALUES($1,$2) ON CONFLICT(table_name) DO UPDATE SET value=greatest(row_counters.value,excluded.value)",[spec.name,Math.max(...rows.map(r=>Number(r[counter])))]);
+      await this.db.query("INSERT INTO meldiq_private.migration_batches(run_id,table_name,batch_number,record_count,sha256) VALUES($1,$2,$3,$4,$5)",[runId,spec.name,number,rows.length,sha256]);
+      return {inserted,resumed:false,sha256};
+    });
+  }
+  async compareRows(spec: TableSpec, rows: Row[]): Promise<void> {
+    const pk=spec.primaryKey.length?spec.primaryKey:["rowid"];
+    if(!rows.length)return;
+    const keyOf=(row:Row)=>JSON.stringify(pk.map(c=>row[c]));
+    const values=rows.flatMap(row=>pk.map(c=>row[c]));
+    const groups=rows.map((_,n)=>`(${pk.map((_,i)=>`$${n*pk.length+i+1}`).join(",")})`).join(",");
+    const result=await this.db.query(`SELECT * FROM meldiq.${q(spec.name)} WHERE (${pk.map(q)}) IN (${groups})`,values);
+    const foundByKey=new Map(result.rows.map(row=>[keyOf(row),row]));
+    for(const row of rows) {
+      const found=foundByKey.get(keyOf(row));
+      if(!found || rowHash(found)!==rowHash(row)) {
+        throw new Error(`Migration discrepancy table=${spec.name} keyDigest=${digest(keyOf(row))} sourceDigest=${rowHash(row)} destinationDigest=${found?rowHash(found):"missing"}`);
+      }
+    }
+  }
+}
diff --git a/server/src/infrastructure/database/postgres/nativeCatalog.ts b/server/src/infrastructure/database/postgres/nativeCatalog.ts
new file mode 100644
index 00000000..fdc63174
--- /dev/null
+++ b/server/src/infrastructure/database/postgres/nativeCatalog.ts
@@ -0,0 +1,52 @@
+import type { TableSpec, ColumnSpec } from "../mongo/catalog.js";
+import { tableSpecs } from "../mongo/catalog.js";
+
+/** Explicit fields from the release's native Mongo stores, not arbitrary whole-document JSONB.
+ * Arrays are bounded configuration/metric sets; commands/activity/options are flexible rendering documents.
+ */
+const column=(name:string,type:string,notNull=true):ColumnSpec=>({name,type,notNull});
+const fields=(text:string,integer="",nullableText="",nullableInteger="",boolean="",json="",arrays=""):ColumnSpec[]=>[
+  ...text.split(" ").filter(Boolean).map(n=>column(n,"TEXT")),...integer.split(" ").filter(Boolean).map(n=>column(n,"INTEGER")),
+  ...nullableText.split(" ").filter(Boolean).map(n=>column(n,"TEXT",false)),...nullableInteger.split(" ").filter(Boolean).map(n=>column(n,"INTEGER",false)),
+  ...boolean.split(" ").filter(Boolean).map(n=>column(n,"BOOLEAN")),...json.split(" ").filter(Boolean).map(n=>column(n,"JSONB")),...arrays.split(" ").filter(Boolean).map(n=>column(n,"TEXT[]")),
+];
+const table=(name:string,domain:TableSpec["domain"],columns:ColumnSpec[],refs:Record<string,string>={}):TableSpec=>({name,domain,columns:[column("id","TEXT"),...columns],primaryKey:["id"],indexes:[],foreignKeys:Object.entries(refs).map(([name,parent])=>({columns:[name],table:parent,references:["id"],onDelete:"CASCADE"})),autoincrement:false});
+export const NATIVE_TABLES:TableSpec[]=[
+  // New staged Auth policy state, not a source Mongo collection or a second credential store.
+  table("auth_device_sessions","accounts",fields("auth_user_id account_id user_id device_id link_method","password_changed_at bound_at","","revoked_at"),{account_id:"accounts",user_id:"users",device_id:"devices"}),
+  table("points_accounts","identity",fields("","balance earned_total level streak updated_at","last_visit_day")),
+  table("points_ledger","identity",fields("user_id kind day","amount at","detail"),{user_id:"users"}),
+  table("points_days","identity",[...fields("user_id day","earned","","","","","chats reacted replied"),column("minutes","BIGINT[]")],{user_id:"users"}),
