@@ -0,0 +1,28 @@
+import fs from "node:fs";
+import path from "node:path";
+import { NATIVE_TABLES } from "../src/infrastructure/database/postgres/nativeCatalog.js";
+const root=process.argv[2];if(!root)throw new Error("Web root required");
+const q=(s:string)=>`"${s}"`;
+const types:Record<string,string>={TEXT:"text",INTEGER:"bigint",BOOLEAN:"boolean",JSONB:"jsonb","TEXT[]":"text[]","BIGINT[]":"bigint[]"};
+const lines=["-- Explicit normalized fields from native Mongo implementations in release695f80b1."];
+for(const t of NATIVE_TABLES){
+  lines.push(`CREATE TABLE meldiq.${q(t.name)} (\n${t.columns.map(c=>`  ${q(c.name)} ${types[c.type]}${c.notNull?" NOT NULL":""}`).join(",\n")},\n  PRIMARY KEY(id)\n);`);
+  for(const c of t.columns.filter(c=>c.name!=="id"&&(/_id$/.test(c.name)||/(?:_at|_expires_at)$/.test(c.name))))lines.push(`CREATE INDEX ${q(`native_${t.name}_${c.name}`)} ON meldiq.${q(t.name)} (${q(c.name)});`);
+  lines.push(`ALTER TABLE meldiq.${q(t.name)} ENABLE ROW LEVEL SECURITY;`,`ALTER TABLE meldiq.${q(t.name)} FORCE ROW LEVEL SECURITY;`,`REVOKE ALL ON meldiq.${q(t.name)} FROM PUBLIC, anon, authenticated;`,`GRANT SELECT, INSERT, UPDATE, DELETE ON meldiq.${q(t.name)} TO meldiq_api;`,`CREATE POLICY trusted_backend ON meldiq.${q(t.name)} FOR ALL TO meldiq_api USING(true) WITH CHECK(true);`);
+}
+for(const t of NATIVE_TABLES)for(const[i,f]of t.foreignKeys.entries())lines.push(`ALTER TABLE meldiq.${q(t.name)} ADD CONSTRAINT ${q(`native_${t.name}_fk_${i}`)} FOREIGN KEY (${f.columns.map(q)}) REFERENCES meldiq.${q(f.table)} (${f.references.map(q)}) ON DELETE ${f.onDelete} DEFERRABLE INITIALLY DEFERRED;`);
+for(const[table,fields]of Object.entries({points_days:["user_id","day"],points_invites:["org_id","joiner_id"],community_pin_awards:["pin_id","user_id"],community_rule_agreements:["org_id","user_id"],decoration_favorites:["user_id","decoration_id"],linked_accounts:["user_id","provider"],oauth_grants:["app_id","user_id"]}))lines.push(`CREATE UNIQUE INDEX ${q(`native_${table}_ownership`)} ON meldiq.${q(table)} (${fields.map(q)});`);
+for(const[table,fields]of Object.entries({bots:["token_hash"],oauth_tokens:["access_hash","refresh_hash","previous_refresh_hash"]}))for(const f of fields)lines.push(`CREATE UNIQUE INDEX ${q(`native_${table}_${f}_unique`)} ON meldiq.${q(table)} (${q(f)});`);
+for(const table of ["creator_verifications","creator_program"])lines.push(`CREATE UNIQUE INDEX ${q(`native_${table}_pending_user`)} ON meldiq.${q(table)}(user_id) WHERE status='pending';`);
+lines.push("CREATE UNIQUE INDEX native_creator_post_url ON meldiq.creator_posts(user_id,url);","ALTER TABLE meldiq.points_accounts ADD CHECK(balance >= 0 AND earned_total >= 0 AND level >= 1 AND streak >= 0);","ALTER TABLE meldiq.points_invites ADD CHECK(state IN ('pending','credited','lapsed','capped'));","ALTER TABLE meldiq.profile_decorations ADD CHECK(status IN ('pending','approved','rejected','removed') AND size >= 0 AND wearers >= 0);");
+for(const table of ["creator_verifications","creator_program"])lines.push(`ALTER TABLE meldiq.${q(table)} ADD CHECK(status IN ('pending','approved','rejected'));`);
+const migration=path.join(root,"supabase/migrations/20261102000400_native_relations.sql"),sql=lines.join("\n")+"\n";
+if(!process.argv.includes("--catalog-only")){
+  if(fs.existsSync(migration)&&fs.readFileSync(migration,"utf8")!==sql)throw new Error("Applied native migration is immutable: add a reviewed numbered SQL migration, then regenerate with --catalog-only");
+  if(!fs.existsSync(migration))fs.writeFileSync(migration,sql,{flag:"wx"});
+}else{
+  const applied=fs.readdirSync(path.join(root,"supabase/migrations")).filter(file=>file.endsWith(".sql")).map(file=>fs.readFileSync(path.join(root,"supabase/migrations",file),"utf8")).join("\n");
+  for(const table of NATIVE_TABLES)if(!applied.includes(`CREATE TABLE meldiq.${q(table.name)}`))throw new Error(`Write the explicit migration for ${table.name} before updating its catalog`);
+}
+fs.writeFileSync(path.join(root,"supabase/generated/native-catalog.json"),JSON.stringify({tables:NATIVE_TABLES},null,2)+"\n");
+console.log(JSON.stringify({nativeTables:NATIVE_TABLES.length}));
diff --git a/server/scripts/supabase-reconcile.ts b/server/scripts/supabase-reconcile.ts
new file mode 100644
index 00000000..126bbe73
--- /dev/null
+++ b/server/scripts/supabase-reconcile.ts
@@ -0,0 +1,49 @@
+import fs from "node:fs";
+import path from "node:path";
+import readline from "node:readline";
+import { postgresTableSpecs as tableSpecs } from "../src/infrastructure/database/postgres/nativeCatalog.js";
+import { MeldiqPostgres, identifier as q } from "../src/infrastructure/database/postgres/client.js";
+import { TypedPostgresImporter, validateRow, tableCounts } from "../src/infrastructure/database/postgres/migration.js";
+
+async function main() {
+  const [snapshot,output]=process.argv.slice(2);
+  if(!snapshot||!output||!process.env.SUPABASE_DATABASE_URL)throw new Error("Snapshot, report path and private database URL required");
+  const environment=process.env.SUPABASE_ENVIRONMENT;
+  if(environment!=="development"&&environment!=="staging")throw new Error("Only staging/development reconciliation is enabled in this release");
+  const db=new MeldiqPostgres({url:process.env.SUPABASE_DATABASE_URL,environment,ca:process.env.SUPABASE_DB_CA_FILE?fs.readFileSync(process.env.SUPABASE_DB_CA_FILE,"utf8"):undefined,maxConnections:1});
+  const compare=new TypedPostgresImporter(db);
+  const report:{observedAt:string;synthetic:boolean;tables:unknown[];ok:boolean}={observedAt:new Date().toISOString(),synthetic:true,tables:[],ok:false};
+  try {
+    const manifest=JSON.parse(fs.readFileSync(path.join(snapshot,"manifest.json"),"utf8"));
+    if(!manifest.synthetic||!manifest.frozen)throw new Error("Frozen synthetic snapshot required");
+    const counts=await tableCounts(db,tableSpecs());
+    for(const spec of tableSpecs()){
+      let count=0;
+      const timestamps=spec.columns.filter(c=>c.type==="INTEGER"&&/(?:_at|_ts)$/.test(c.name)).map(c=>c.name);
+      const money=spec.columns.filter(c=>c.type==="INTEGER"&&/(?:_minor|_cents)$/.test(c.name)).map(c=>c.name);
+      const extrema:Record<string,{min:number;max:number}>={},totals:Record<string,bigint>=Object.fromEntries(money.map(k=>[k,0n]));
+      const lines=readline.createInterface({input:fs.createReadStream(path.join(snapshot,`${spec.name}.ndjson`)),crlfDelay:Infinity});
+      let batch:Record<string,unknown>[]=[];
+      for await(const line of lines){
+        const row=validateRow(spec,JSON.parse(line));count++;batch.push(row);
+        for(const key of timestamps)if(typeof row[key]==="number"){const value=row[key] as number;const old=extrema[key];extrema[key]={min:Math.min(old?.min??value,value),max:Math.max(old?.max??value,value)};}
+        for(const key of money)if(row[key]!==null)totals[key]+=BigInt(row[key] as number);
+        if(batch.length===250){await compare.compareRows(spec,batch);batch=[];}
+      }
+      if(batch.length)await compare.compareRows(spec,batch);
+      const destination=counts.get(spec.name);
+      if(count!==destination||count!==manifest.tables.find((t:{name:string})=>t.name===spec.name)?.count)throw new Error(`Count mismatch ${spec.name}`);
+      for(const [key,value] of Object.entries(extrema)){
+        const actual=(await db.query(`SELECT min(${q(key)}) AS min,max(${q(key)}) AS max FROM meldiq.${q(spec.name)}`)).rows[0];
+        if(actual.min!==value.min||actual.max!==value.max)throw new Error(`Timestamp mismatch ${spec.name}`);
+      }
+      for(const [key,value] of Object.entries(totals)){
+        const actual=(await db.query(`SELECT coalesce(sum(${q(key)}),0)::text AS total FROM meldiq.${q(spec.name)}`)).rows[0].total;
+        if(actual!==value.toString())throw new Error(`Financial mismatch ${spec.name}`);
+      }
+      report.tables.push({name:spec.name,source:count,destination,allRecordHashesMatch:true,timestampRanges:extrema,financialTotalsMinor:Object.fromEntries(Object.entries(totals).map(([k,v])=>[k,v.toString()]))});
+    }
+    report.ok=true;
+  }finally{await db.close();fs.writeFileSync(output,JSON.stringify(report,null,2)+"\n",{mode:0o600});}
+}
+main().catch(()=>{console.error("Reconciliation failed; report is incomplete. No data was modified.");process.exitCode=1;});
diff --git a/server/scripts/supabase-s3-readonly.mjs b/server/scripts/supabase-s3-readonly.mjs
new file mode 100644
index 00000000..7c311354
--- /dev/null
+++ b/server/scripts/supabase-s3-readonly.mjs
@@ -0,0 +1,112 @@
+/** Stream through docker exec stdin; read existing Atlas metadata and S3 HEAD only. Never loads application bootstrap. */
+import crypto from "node:crypto";
+import fs from "node:fs/promises";
+import {constants as fsConstants} from "node:fs";
+import path from "node:path";
+
+const report = {observedAt: new Date().toISOString(), scope: "live source attachment metadata versus existing S3 objects",
+  sourceFrozen: false, applicationDataWrites: 0, objectWrites: 0, objectBytesDownloaded: 0, keysOrBucketsChanged: false,
+  contentHashVerified: false, concurrency: 4, anomalies: []};
+const hash = value => crypto.createHash("sha256").update(value).digest("hex");
+let mongo, s3;
+try {
+  if (process.env.MELDIQ_READONLY_S3_AUDIT !== "1" || process.env.DATABASE_MODE !== "atlas" || !(process.env.MONGODB_DOMAINS ?? "").split(",").map(value => value.trim()).includes("files")) throw new Error("Explicit Atlas files read-only audit required");
+  if (process.env.STORAGE_BACKEND !== "s3" || !process.env.S3_BUCKET || !(process.env.S3_REGION || process.env.AWS_REGION) || !process.env.MONGODB_DB?.trim()) throw new Error("Existing S3 and explicit source database configuration required");
+  const {MongoClient} = await import("mongodb");
+  const {S3Client, HeadObjectCommand} = await import("@aws-sdk/client-s3");
+  const region = (process.env.S3_REGION ?? process.env.AWS_REGION).trim();
+  let prefix = (process.env.S3_PREFIX ?? "orbit/").trim();
+  if (prefix && !prefix.endsWith("/")) prefix += "/";
+  const credentials = process.env.S3_ACCESS_KEY_ID && process.env.S3_SECRET_ACCESS_KEY ? {
+    accessKeyId: process.env.S3_ACCESS_KEY_ID.trim(), secretAccessKey: process.env.S3_SECRET_ACCESS_KEY.trim(),
+    ...(process.env.S3_SESSION_TOKEN ? {sessionToken: process.env.S3_SESSION_TOKEN.trim()} : {}),
+  } : undefined;
+  s3 = new S3Client({region, credentials, endpoint: process.env.S3_ENDPOINT?.trim() || undefined,
+    forcePathStyle: process.env.S3_FORCE_PATH_STYLE === "true", maxAttempts: 2,
+    requestHandler: {connectionTimeout: 5000, requestTimeout: 10000, httpsAgent: {keepAlive: true, maxSockets: 4}}});
+  mongo = new MongoClient(process.env.MONGODB_URI, {maxPoolSize: 1, minPoolSize: 0, serverSelectionTimeoutMS: 10000, appName: "meldiq-supabase-readonly-s3-audit"});
+  await mongo.connect();
+  const attachments = mongo.db(process.env.MONGODB_DB.trim()).collection("attachments");
+  report.sourceCountStart = await attachments.countDocuments({}, {maxTimeMS: 10000});
+  if (!report.sourceCountStart) throw new Error("Known source attachment metadata is unexpectedly empty");
+  if (report.sourceCountStart > 5000) throw new Error("Source exceeds bounded audit scope; prepare a reviewed paged run");
+  const rows = await attachments.find({}, {projection: {_id: 1, id: 1, size: 1, created_at: 1, expires_at: 1, conversation_id: 1, uploader_user_id: 1},
+    batchSize: 200, maxTimeMS: 20000, readConcern: {level: "majority"}}).toArray();
+  rows.sort((a, b) => String(a._id).localeCompare(String(b._id), "en"));
+  report.sourceRecords = rows.length;
+  report.sourceMetadataSha256 = hash(JSON.stringify(rows.map(row => [String(row._id), row.id, String(row.size), String(row.created_at), String(row.expires_at)])));
+  report.region = region;
+  report.localReadFallbackConfigured = process.env.STORAGE_READ_FALLBACK?.trim() === "local";
+  report.localFallbackByteMatches = 0;
+  report.localFallbackReadableMatches = 0;
+  report.localFallbackExpectedBytes = "0";
+  report.bucketAndPrefixSha256 = hash(`${process.env.S3_BUCKET.trim()}\n${prefix}`);
+  report.headSucceeded = 0; report.exactByteLengthMatches = 0; report.expectedBytes = "0";
+  report.http403Indeterminate = 0; report.http404NotFound = 0; report.otherHeadErrors = 0;
+  const proofs = [], sizes = [], unresolved = [];
+  const localDirectory = process.env.ATTACHMENT_DIR ?? path.join(process.env.DATA_DIR ?? path.resolve("data"), "attachments");
+  let index = 0;
+  await Promise.all(Array.from({length: 4}, async () => {
+    while (index < rows.length) {
+      const row = rows[index++], id = row.id ?? row._id, bytes = Number(String(row.size));
+      const keyDigest = hash(String(id));
+      if (typeof id !== "string" || !/^[A-Za-z0-9_-]{1,100}$/.test(id) || !Number.isSafeInteger(bytes) || bytes < 0 || String(row._id) !== id) {
+        report.anomalies.push({keyDigest, kind: "invalid_source_metadata"}); continue;
+      }
+      sizes.push(BigInt(bytes));
+      try {
+        const result = await s3.send(new HeadObjectCommand({Bucket: process.env.S3_BUCKET.trim(), Key: `${prefix}attachments/${id}`}), {abortSignal: AbortSignal.timeout(12000)});
+        report.headSucceeded++;
+        proofs.push({keyDigest, bytes: result.ContentLength, etagSha256: typeof result.ETag === "string" ? hash(result.ETag) : null,
+          lastModified: result.LastModified?.toISOString() ?? null});
+        if (result.ContentLength === bytes) report.exactByteLengthMatches++;
+        else report.anomalies.push({keyDigest, kind: "size_mismatch", expectedBytes: bytes, actualBytes: result.ContentLength ?? null});
+      } catch (error) {
+        const status = error?.$metadata?.httpStatusCode;
+        if (status === 403) report.http403Indeterminate++;
+        else if (status === 404) report.http404NotFound++;
+        else report.otherHeadErrors++;
+        const anomaly = {keyDigest, kind: status === 403 ? "forbidden_or_missing" : status === 404 ? "not_found" : "head_failed", httpStatus: Number.isInteger(status) ? status : null};
+        if (status === 404) {
+          // Matches the existing LocalBlobStore path; stat reads no object bytes and creates no directories.
+          const local = await fs.stat(path.join(localDirectory, id)).catch(() => null);
+          anomaly.localFileExists = !!local?.isFile();
+          anomaly.localBytesMatch = !!local?.isFile() && local.size === bytes;
+          anomaly.localReadable = !!local?.isFile() && await fs.access(path.join(localDirectory, id), fsConstants.R_OK).then(() => true, () => false);
+          if (report.localReadFallbackConfigured && anomaly.localBytesMatch) report.localFallbackByteMatches++;
+          if (report.localReadFallbackConfigured && anomaly.localBytesMatch && anomaly.localReadable) {
+            report.localFallbackReadableMatches++;
+            report.localFallbackExpectedBytes = (BigInt(report.localFallbackExpectedBytes) + BigInt(bytes)).toString();
+          }
+          anomaly.expiredMetadata = Number(String(row.expires_at)) <= Date.now();
+          anomaly.createdAt = Number.isSafeInteger(Number(String(row.created_at))) ? Number(String(row.created_at)) : null;
+          unresolved.push({row, anomaly});
+        }
+        report.anomalies.push(anomaly);
+      }
+    }
+  }));
+  report.expectedBytes = sizes.reduce((sum, value) => sum + value, 0n).toString();
+  proofs.sort((a, b) => a.keyDigest.localeCompare(b.keyDigest, "en"));
+  report.objectMetadataProofSha256 = hash(JSON.stringify(proofs));
+  const source = mongo.db(process.env.MONGODB_DB.trim());
+  const conversations = new Set((await source.collection("conversations").find({_id: {$in: [...new Set(unresolved.map(item => item.row.conversation_id))]}}, {projection: {_id: 1}, maxTimeMS: 10000}).toArray()).map(row => String(row._id)));
+  const users = new Set((await source.collection("users").find({_id: {$in: [...new Set(unresolved.map(item => item.row.uploader_user_id))]}}, {projection: {_id: 1}, maxTimeMS: 10000}).toArray()).map(row => String(row._id)));
+  for (const item of unresolved) {
+    item.anomaly.conversationExists = conversations.has(String(item.row.conversation_id));
+    item.anomaly.uploaderExists = users.has(String(item.row.uploader_user_id));
+  }
+  report.sourceCountEnd = await attachments.countDocuments({}, {maxTimeMS: 10000});
+  report.allReferencedS3ObjectsMatched = report.anomalies.length === 0 && rows.length === report.sourceCountStart && rows.length === report.sourceCountEnd;
+  report.currentStorageAvailabilityPassed = report.exactByteLengthMatches + report.localFallbackReadableMatches === rows.length && rows.length === report.sourceCountStart && rows.length === report.sourceCountEnd;
+  report.ok = report.allReferencedS3ObjectsMatched;
+} catch (error) {
+  report.ok = false;
+  report.errorCode = typeof error?.code === "string" && /^[A-Z0-9_]{3,40}$/.test(error.code) ? error.code : "audit_failed";
+} finally {
+  await mongo?.close().catch(() => {});
+  s3?.destroy();
+  report.completedAt = new Date().toISOString();
+  process.stdout.write(JSON.stringify(report, null, 2) + "\n");
+  if (!report.ok) process.exitCode = 1;
+}
diff --git a/server/scripts/supabase-schema.ts b/server/scripts/supabase-schema.ts
new file mode 100644
index 00000000..acf54c9f
--- /dev/null
+++ b/server/scripts/supabase-schema.ts
@@ -0,0 +1,92 @@
+/** Reproducible relational migration from the inspected release; no business data is read. */
+import fs from "node:fs";
+import path from "node:path";
+import crypto from "node:crypto";
+import { execFileSync } from "node:child_process";
+import { openDatabase } from "../src/infrastructure/database/db.js";
+import { describeTables } from "../src/infrastructure/database/mongo/catalog.js";
+
+const root = process.argv[2];
+if (!root) throw new Error("Usage: tsx scripts/supabase-schema.ts /absolute/web/root");
+const db = openDatabase(":memory:");
+const tables = describeTables(db);
+const q = (s: string) => `"${s.replaceAll('"', '""')}"`;
+const ident = (s: string) => s.length <= 63 ? s : `${s.slice(0, 50)}_${crypto.createHash("sha256").update(s).digest("hex").slice(0, 12)}`;
+const sqlType = (t: string) => ({ TEXT: "text", INTEGER: "bigint", REAL: "double precision", BLOB: "bytea" })[t] ?? (() => { throw new Error(`Unsupported type ${t}`); })();
+const checks = (sql: string): string[] => {
+  const result: string[] = [];
+  const re = /\bCHECK\s*\(/gi;
+  let m: RegExpExecArray | null;
+  while ((m = re.exec(sql))) {
+    let level = 1, quote = false, i = re.lastIndex;
+    const start = i;
+    for (; i < sql.length && level; i++) {
+      if (sql[i] === "'") {
+        if (quote && sql[i + 1] === "'") { i++; continue; }
+        quote = !quote;
+      }
+      if (!quote) { if (sql[i] === "(") level++; if (sql[i] === ")") level--; }
+    }
+    if (level) throw new Error("Unbalanced CHECK");
+    result.push(sql.slice(start, i - 1));
+    re.lastIndex = i;
+  }
+  return result;
+};
+const catalog = tables.map(t => ({ ...t, checks: checks((db.prepare("SELECT sql FROM sqlite_master WHERE name = ?").get(t.name) as { sql: string }).sql) }));
+const sourceCommit = execFileSync("git", ["rev-parse", process.env.MELDIQ_SOURCE_BASE ?? "HEAD"], { encoding: "utf8" }).trim();
+const additive = process.argv.includes("--additive");
+const catalogPath = path.join(root,"supabase/generated/source-catalog.json");
+const previous = additive ? JSON.parse(fs.readFileSync(catalogPath,"utf8")) as {tables:typeof catalog} : null;
+if(previous)for(const old of previous.tables){const current=catalog.find(t=>t.name===old.name);if(!current||JSON.stringify(current)!==JSON.stringify(old))throw new Error(`Existing relation changed and requires a reviewed ALTER migration: ${old.name}`);}
+const selected=previous?catalog.filter(t=>!previous.tables.some(old=>old.name===t.name)):catalog;
+if(additive&&!selected.length){db.close();console.log(JSON.stringify({upToDate:true,tables:catalog.length}));process.exit(0);}
+const manifest = { sourceCommit, sourceSchema: db.prepare("SELECT max(version) AS version FROM schema_migrations").get(), tables: catalog };
+const lines = additive ? ["-- Additive release relations from " + sourceCommit + "; prior migrations remain immutable."] : [
+  "-- Generated from release " + sourceCommit + "; do not edit by hand.",
+  "-- Epoch-millisecond columns preserve the released UTC/API contract. New operational time columns use timestamptz.",
+  "CREATE SCHEMA meldiq;",
+  "CREATE SCHEMA meldiq_private;",
+  "REVOKE ALL ON SCHEMA meldiq, meldiq_private FROM PUBLIC, anon, authenticated;",
+  "DO $$ BEGIN IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'meldiq_api') THEN CREATE ROLE meldiq_api NOLOGIN NOBYPASSRLS; END IF; END $$;",
+  "GRANT USAGE ON SCHEMA meldiq, meldiq_private TO meldiq_api;",
+  "ALTER DEFAULT PRIVILEGES IN SCHEMA meldiq, meldiq_private REVOKE EXECUTE ON FUNCTIONS FROM PUBLIC;",
+];
+for (const t of selected) {
+  const cols = t.columns.map(c => {
+    let def = "";
+    if (c.default !== undefined) {
+      if (typeof c.default === "object" && c.default !== null) throw new Error(`Expression default requires review: ${t.name}.${c.name}`);
+      def = ` DEFAULT ${c.default === null ? "NULL" : typeof c.default === "string" ? `'${c.default.replaceAll("'", "''")}'` : c.default}`;
+    }
+    return `  ${q(c.name)} ${sqlType(c.type)}${c.notNull || t.primaryKey.includes(c.name) ? " NOT NULL" : ""}${def}`;
+  });
+  if (!t.primaryKey.length) cols.push('  "rowid" bigint NOT NULL PRIMARY KEY');
+  else cols.push(`  PRIMARY KEY (${t.primaryKey.map(q).join(", ")})`);
+  for (const c of t.checks) cols.push(`  CHECK (${c})`);
+  lines.push(`CREATE TABLE meldiq.${q(t.name)} (\n${cols.join(",\n")}\n);`);
+  for (const ix of t.indexes) {
+    const columns = ix.columns.map(c => ix.nocase || t.columns.find(col => col.name === c)?.nocase
+      ? `(translate(${q(c)}, 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz'))` : q(c));
+    lines.push(`CREATE ${ix.unique ? "UNIQUE " : ""}INDEX ${q(ident(`${t.name}_${ix.name}`))} ON meldiq.${q(t.name)} (${columns.join(", ")})${ix.partialNotNull ? ` WHERE ${ix.partialNotNull.map(c => `${q(c)} IS NOT NULL`).join(" AND ")}` : ""};`);
+  }
+  lines.push(`ALTER TABLE meldiq.${q(t.name)} ENABLE ROW LEVEL SECURITY;`, `ALTER TABLE meldiq.${q(t.name)} FORCE ROW LEVEL SECURITY;`,
+    `REVOKE ALL ON meldiq.${q(t.name)} FROM PUBLIC, anon, authenticated;`,
+    `GRANT SELECT, INSERT, UPDATE, DELETE ON meldiq.${q(t.name)} TO meldiq_api;`,
+    `CREATE POLICY trusted_backend ON meldiq.${q(t.name)} FOR ALL TO meldiq_api USING (true) WITH CHECK (true);`);
+}
+for (const t of selected) for (const [i, fk] of t.foreignKeys.entries()) {
+  if (!catalog.some(p => p.name === fk.table)) throw new Error(`Unmapped FK ${t.name} -> ${fk.table}`);
+  lines.push(`ALTER TABLE meldiq.${q(t.name)} ADD CONSTRAINT ${q(ident(`${t.name}_fk_${i}`))} FOREIGN KEY (${fk.columns.map(q).join(", ")}) REFERENCES meldiq.${q(fk.table)} (${fk.references.map(q).join(", ")}) ON DELETE ${fk.onDelete} DEFERRABLE INITIALLY DEFERRED;`);
+}
+const dir = path.join(root, "supabase");
+fs.mkdirSync(path.join(dir, "generated"), { recursive: true });
+const migration=path.join(dir,"migrations",additive?"20261102000600_administration_relations.sql":"20261102000100_release_relations.sql");
+const sql=lines.join("\n")+"\n";
+if(fs.existsSync(migration)&&fs.readFileSync(migration,"utf8")!==sql)throw new Error("Applied migration is immutable; create a new migration version");
+fs.writeFileSync(migration,sql);
+fs.writeFileSync(path.join(dir, "generated", "source-catalog.json"), JSON.stringify(manifest, null, 2) + "\n");
+const types = catalog.map(t => `  ${q(t.name)}: {\n${t.columns.map(c => `    ${q(c.name)}: ${c.type === "TEXT" ? "string" : c.type === "BLOB" ? "Uint8Array" : "number"}${!c.notNull && !t.primaryKey.includes(c.name) ? " | null" : ""};`).join("\n")}\n  };`).join("\n");
+fs.writeFileSync(path.join(dir, "generated", "database.types.ts"), `// Generated from ${sourceCommit}; wire epoch timestamps are UTC milliseconds.\nexport interface MeldiqRows {\n${types}\n}\n`);
+db.close();
+console.log(JSON.stringify({ sourceCommit, tables: catalog.length, columns: catalog.reduce((n, t) => n + t.columns.length, 0), foreignKeys: catalog.reduce((n,t) => n+t.foreignKeys.length,0), checks: catalog.reduce((n,t) => n+t.checks.length,0) }));
