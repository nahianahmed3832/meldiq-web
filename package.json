{
  "name": "meldiq-web",
  "version": "0.5.0-beta",
  "private": true,
  "description": "Meldiq Web (formerly Orbit Web): the browser client of Meldiq, a device of the same account on the same server",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nahianahmed3832/meldiq-web.git"
  },
  "homepage": "https://web.meldiq.app",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run -s sw:dev && next dev --hostname 127.0.0.1 --port 5173",
    "build": "tsc -b && rm -rf out && next build && node scripts/finish-export.mjs && vite build --config vite.sw.config.ts",
    "sw:dev": "vite build --config vite.sw.config.ts --outDir public --mode development",
    "preview": "node scripts/web-server.ts dist 4173",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"test/**/*.ts\" \"e2e/**/*.ts\" \"scripts/**/*.{ts,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"test/**/*.ts\" \"e2e/**/*.ts\" \"scripts/**/*.{ts,mjs}\"",
    "test": "vitest run --exclude 'test/live*.test.ts'",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "test:integration": "vitest run test/live",
    "test:all": "vitest run"
  },
  "dependencies": {
    "@hpke/core": "1.9.0",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "firebase": "12.19.0",
    "idb": "8.0.4",
    "livekit-client": "2.22.3",
    "lucide-react": "1.59.0",
    "next": "16.3.8",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.6",
    "globals": "17.13.0",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "ws": "8.22.0"
  },
  "browserslist": [
    "safari >= 16.4",
    "ios_saf >= 16.4",
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 113"
  ]
}
