+  const sqliteArgs = () =>
+    Object.fromEntries(values.map((v, i) => [`p${i + 1}`, v]));
+  const found = (
+    pg
+      ? (await ctx.postgres!.database.query<MessageEvent>(sql, values)).rows
+      : (ctx.db.prepare(sql).all(sqliteArgs()) as MessageEvent[])
