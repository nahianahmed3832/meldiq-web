+++ b/server/test/quick_reactions.test.ts
@@ -0,0 +1,65 @@
+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+import { expectStatus, startServer, type Harness } from "./support/harness.js";
+for (const backend of process.env.MELDIQ_TEST_PG_URL
+  ? ["postgres"]
+  : ["sqlite", "mongodb"])
+  describe(`quick reaction preferences (${backend})`, () => {
+    let h: Harness;
+    beforeAll(async () => {
+      h = await startServer({
+        MONGODB_DOMAINS: backend === "mongodb" ? "preferences" : "",
+      });
+    });
+    afterAll(async () => h?.close());
+    it("persists 3–5 distinct choices, preserves older client omissions, isolates accounts and rejects stale writes", async () => {
+      const alice = await h.client("quickalice"),
+        bob = await h.client("quickbob");
+      const base = await alice.req("GET", "/v1/me/preferences/personal");
+      const path = "/v1/me/preferences/personal";
+      const choices = ["✅", "🔥", "🙏"];
+      const saved = await alice.req("PUT", path, {
+        baseRev: base.rev,
+        prefs: { quickReactions: choices },
+      });
+      expect(saved.prefs.quickReactions).toEqual(choices);
+      expect((await bob.req("GET", path)).prefs.quickReactions).toBeUndefined();
+      expect((await alice.req("GET", path)).prefs.quickReactions).toEqual(
+        choices,
+      );
+      const old = await alice.req("PUT", path, {
+        baseRev: saved.rev,
+        prefs: {},
+      });
+      expect(old.prefs.quickReactions).toEqual(choices);
+      await expectStatus(
+        alice.req("PUT", path, {
+          baseRev: saved.rev,
+          prefs: { quickReactions: ["👍", "❤️", "😂"] },
+        }),
+        409,
+      );
+      for (const values of [
+        ["👍"],
+        ["👍", "👍", "❤️"],
+        ["bad", "👍", "❤️"],
+        ["👍", "❤️", "✅", "😂", "🔥", "🙏"],
+      ])
+        await expectStatus(
+          alice.req("PUT", path, {
+            baseRev: old.rev,
+            prefs: { quickReactions: values },
+          }),
+          400,
+        );
+      const org = (
+        await alice.req("POST", "/v1/orgs", { name: "Quick fixture" })
+      ).org.id;
+      await expectStatus(
+        alice.req("PUT", `/v1/me/preferences/${org}`, {
+          baseRev: 0,
+          prefs: { quickReactions: choices },
+        }),
+        400,
+      );
+    });
+  });
diff --git a/server/test/report_resolution.test.ts b/server/test/report_resolution.test.ts
new file mode 100644
index 00000000..146df985
--- /dev/null
+++ b/server/test/report_resolution.test.ts
@@ -0,0 +1,85 @@
+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+import { expectStatus, startServer, type Harness } from "./support/harness.js";
+for (const backend of process.env.MELDIQ_TEST_PG_URL
+  ? ["postgres"]
+  : ["sqlite", "mongodb"])
+  describe(`report resolution (${backend})`, () => {
+    let h: Harness;
+    beforeAll(async () => {
+      h = await startServer({
+        MONGODB_DOMAINS: backend === "mongodb" ? "reports" : "",
+      });
+    });
+    afterAll(async () => h?.close());
+    it("applies concurrent retries once, preserves the first handler/time, audits real changes and never sanctions", async () => {
+      const owner = await h.client("resowner"),
+        reporter = await h.client("resreporter"),
+        target = await h.client("restarget");
+      const org = (
+        await owner.req("POST", "/v1/orgs", { name: "Resolution fixture" })
+      ).org.id;
+      const code = (
+        await owner.req("POST", `/v1/orgs/${org}/invites`, {
+          role: "MEMBER",
+          maxUses: 2,
+        })
+      ).invite.code;
+      for (const c of [reporter, target])
+        await c.req("POST", "/v1/invites/accept", { code });
+      const id = (
+        await reporter.req("POST", "/v1/reports", {
+          targetUserId: target.userId,
+          orgId: org,
+          reason: "spam",
+        })
+      ).report.id;
+      const path = `/v1/reports/${id}`;
+      await expectStatus(
+        reporter.req("PATCH", path, { status: "actioned" }),
+        404,
+      );
+      const before = h.ctx.ws.get("org_members", {
+        org_id: org,
+        user_id: target.userId,
+      });
+      const responses = await Promise.all(
+        Array.from({ length: 3 }, () =>
+          owner.req("PATCH", path, { status: "actioned", note: " Reviewed " }),
+        ),
+      );
+      expect(new Set(responses.map((r) => r.report.handledAt)).size).toBe(1);
+      const first = (await h.ctx.reports.get(id))!;
+      expect(first).toMatchObject({
+        handled_by: owner.userId,
+        handled_note: "Reviewed",
+      });
+      const audit = async () =>
+        (
+          await owner.req("GET", `/v1/orgs/${org}/audit?action=report`)
+        ).entries.filter((e: any) => e.target === id);
+      expect(await audit()).toHaveLength(1);
+      await owner.req("PATCH", path, { status: "actioned", note: "Reviewed" });
+      expect(await h.ctx.reports.get(id)).toEqual(first);
+      expect(await audit()).toHaveLength(1);
+      await owner.req("PATCH", path, {
+        status: "actioned",
+        note: "New decision note",
+      });
+      expect(await audit()).toHaveLength(2);
+      await owner.req("PATCH", path, {
+        status: "open",
+        note: "Ignored on reopen",
+      });
+      expect(await h.ctx.reports.get(id)).toMatchObject({
+        status: "open",
+        handled_at: null,
+        handled_by: null,
+        handled_note: null,
+      });
+      await owner.req("PATCH", path, { status: "open" });
+      expect(await audit()).toHaveLength(3);
+      expect(
+        h.ctx.ws.get("org_members", { org_id: org, user_id: target.userId }),
+      ).toEqual(before);
+    });
+  });
diff --git a/server/test/role_asset_icons.test.ts b/server/test/role_asset_icons.test.ts
new file mode 100644
index 00000000..21fde4b7
--- /dev/null
+++ b/server/test/role_asset_icons.test.ts
@@ -0,0 +1,98 @@
+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+import sharp from "sharp";
+import { expectStatus, startServer, type Harness } from "./support/harness.js";
+for (const backend of process.env.MELDIQ_TEST_PG_URL
+  ? ["postgres"]
+  : ["sqlite", "mongodb"])
+  describe(`validated role icons (${backend})`, () => {
+    let h: Harness;
+    beforeAll(async () => {
+      h = await startServer({
+        MONGODB_DOMAINS:
+          backend === "mongodb" ? "workspace,conversations,files,calls" : "",
+      });
+    });
+    afterAll(async () => h?.close());
+    it("uses same-community available emoji, rejects unauthorized/foreign assets and falls back after removal", async () => {
+      const owner = await h.client("iconowner"),
+        member = await h.client("iconmember"),
+        outsider = await h.client("iconoutsider");
+      const org = (
+        await owner.req("POST", "/v1/orgs", { name: "Icon fixture" })
+      ).org.id;
+      const other = (
+        await owner.req("POST", "/v1/orgs", { name: "Other fixture" })
+      ).org.id;
+      const code = (
+        await owner.req("POST", `/v1/orgs/${org}/invites`, { role: "MEMBER" })
+      ).invite.code;
+      await member.req("POST", "/v1/invites/accept", { code });
+      const png = await sharp({
+        create: { width: 20, height: 20, channels: 3, background: "#a3e635" },
+      })
+        .png()
+        .toBuffer();
+      const upload = async (id: string, kind = "emoji") =>
+        (
+          await owner.req(
+            "POST",
+            `/v1/orgs/${id}/expressions?kind=${kind}&name=lime`,
+            undefined,
+            png,
+          )
+        ).expression;
+      const icon = await upload(org),
+        foreign = await upload(other),
+        sticker = await upload(org, "sticker");
+      const role = (
+        await owner.req("POST", `/v1/orgs/${org}/roles`, {
+          name: "Asset role",
+          permissions: [],
+        })
+      ).role;
+      await owner.req("PUT", `/v1/roles/${role.id}/members/${member.userId}`);
+      const path = `/v1/roles/${role.id}/extras`;
+      await expectStatus(
+        member.req("PUT", path, { iconExpressionId: icon.id }),
+        403,
+      );
+      await expectStatus(
+        outsider.req("PUT", path, { iconExpressionId: icon.id }),
+        404,
+      );
+      for (const id of [foreign.id, sticker.id, "missing"])
+        await expectStatus(
+          owner.req("PUT", path, { iconExpressionId: id }),
+          400,
+        );
+      expect(
+        (await owner.req("PUT", path, { iconExpressionId: icon.id })).extras
+          .iconExpressionId,
+      ).toBe(icon.id);
+      // Older clients changing a different extra preserve the selected icon.
+      expect(
+        (await owner.req("PUT", path, { mentionable: true })).extras
+          .iconExpressionId,
+      ).toBe(icon.id);
+      const directory = async () =>
+        (await member.req("GET", `/v1/orgs/${org}/members`)).members.find(
+          (m: any) => m.id === member.userId,
+        ).customRoles[0];
+      expect((await directory()).iconExpression).toMatchObject({
+        id: icon.id,
+        orgId: org,
+        sha256: icon.sha256,
+      });
+      await expectStatus(
+        outsider.req("GET", `/v1/expressions/${icon.id}/image`),
+        404,
+      );
+      await owner.req("DELETE", `/v1/expressions/${icon.id}`);
+      expect(await directory()).not.toHaveProperty("iconExpression");
+      expect(
+        (await owner.req("GET", `/v1/orgs/${org}/roles`)).roles.find(
+          (r: any) => r.id === role.id,
+        ).extras.iconExpressionId,
+      ).toBeUndefined();
+    });
+  });
