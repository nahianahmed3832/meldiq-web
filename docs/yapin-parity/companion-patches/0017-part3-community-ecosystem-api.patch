+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+import type { MessageEvent } from "../src/modules/messaging/store/messageStore.js";
+import { CollectionResponse } from "../src/shared/contracts/http/messageCollections.js";
+import { expectStatus, startServer, type Harness } from "./support/harness.js";
+for (const backend of process.env.MELDIQ_TEST_PG_URL
+  ? ["postgres"]
+  : ["sqlite", "mongodb"])
+  describe(`authoritative forum pages (${backend})`, () => {
+    let h: Harness;
+    beforeAll(async () => {
+      h = await startServer({
+        MONGODB_DOMAINS: backend === "mongodb" ? "history" : "",
+      });
+    });
+    afterAll(async () => h?.close());
+    it("pages all roots, uses visible reply activity and current edited tags/text, and never exposes private/deleted roots", async () => {
+      const owner = await h.client("forumowner"),
+        member = await h.client("forummember"),
+        outsider = await h.client("forumoutside");
+      const org = (
+        await owner.req("POST", "/v1/orgs", { name: "Forum fixture" })
+      ).org.id;
+      const code = (
+        await owner.req("POST", `/v1/orgs/${org}/invites`, { role: "MEMBER" })
+      ).invite.code;
+      await member.req("POST", "/v1/invites/accept", { code });
+      const cid = (
+        await owner.req("POST", `/v1/orgs/${org}/channels`, {
+          name: "forum",
+          format: "forum",
+          scope: "ORG",
+        })
+      ).channel.id;
+      const at = Date.now() - 100000;
+      const event = (
+        id: string,
+        ts: number,
+        payload: object,
+        extra: Partial<MessageEvent> = {},
+      ): MessageEvent => ({
+        id,
+        conversation_id: cid,
+        sender_user_id: owner.userId,
+        sender_device_id: null,
+        cls: "message",
+        type: "text",
+        target: null,
+        audience: "all",
+        payload: JSON.stringify(payload),
+        sent_at: ts,
+        server_ts: ts,
+        mention_all: 0,
+        imported_by: null,
+        ...extra,
+      });
+      const events = Array.from({ length: 61 }, (_, i) =>
+        event(`forumroot_${String(i).padStart(4, "0")}`, at + 100, {
+          type: "text",
+          text: `Root ${i}`,
+          title: `Title ${i}`,
+          tags: ["tag_one"],
+        }),
+      );
+      events.push(
+        event("root_bumped", at, {
+          type: "text",
+          text: "old root",
+          tags: ["old_tag"],
+        }),
+      );
+      events.push(
+        event(
+          "edit_bumped",
+          at + 1,
+          {
+            type: "edit",
+            target: "root_bumped",
+            text: "edited root",
+            title: "Current title",
+            tags: ["tag_one", "tag_two"],
+          },
+          { cls: "control", type: "edit", target: "root_bumped" },
+        ),
+      );
+      events.push(
+        event(
+          "edit_text_later",
+          at + 2,
+          { type: "edit", target: "root_bumped", text: "Later body" },
+          { cls: "control", type: "edit", target: "root_bumped" },
+        ),
+      );
+      events.push(
+        event("reply_to_bumped", at + 500, {
+          type: "text",
+          text: "visible reply",
+          threadRoot: "root_bumped",
+        }),
+      );
+      events.push(
+        event("deleted_reply", at + 700, {
+          type: "text",
+          text: "deleted reply",
+          threadRoot: "root_bumped",
+        }),
+      );
+      events.push(
+        event(
+          "delete_the_reply",
+          at + 701,
+          { type: "delete", target: "deleted_reply" },
+          { cls: "control", type: "delete", target: "deleted_reply" },
+        ),
+      );
+      events.push(
+        event(
+          "private_reply",
+          at + 900,
+          { type: "text", text: "private reply", threadRoot: "root_bumped" },
+          { audience: "self" },
+        ),
+      );
+      events.push(
+        event(
+          "private_root",
+          at + 800,
+          { type: "text", text: "private root" },
+          { audience: "self" },
+        ),
+      );
+      events.push(
+        event("deleted_root", at + 1000, {
+          type: "text",
+          text: "deleted root",
+        }),
+      );
+      events.push(
+        event(
+          "delete_the_root",
+          at + 1001,
+          { type: "delete", target: "deleted_root" },
+          { cls: "control", type: "delete", target: "deleted_root" },
+        ),
+      );
+      events.push({
+        ...event("bad_forum_json", at + 1002, {}),
+        payload: "malformed",
+      });
+      await h.ctx.messages.addMany(events);
+      const path = `/v2/conversations/${cid}/message-collections`;
+      const read = async (q: string) => {
+        const p = await member.req("GET", `${path}?kind=forum&${q}`);
+        expect(CollectionResponse.safeParse(p).success).toBe(true);
+        return p;
+      };
+      const first = await read("limit=50&sort=latest");
+      expect(first.messages).toHaveLength(50);
+      expect(first.messages[0].id).toBe("root_bumped");
+      expect(first.threads[0]).toEqual({
+        rootId: "root_bumped",
+        replyCount: 1,
+        lastReplyTs: at + 500,
+      });
+      const next = await read(
+        `limit=50&sort=latest&before=${first.nextCursor.serverTs}&beforeId=${first.nextCursor.id}`,
+      );
+      expect(next.messages).toHaveLength(12);
+      expect(next.more).toBe(false);
+      expect(
+        new Set([...first.messages, ...next.messages].map((m) => m.id)).size,
+      ).toBe(62);
+      expect((await read("sort=newest&limit=1")).messages[0].id).toBe(
+        "forumroot_0060",
+      );
+      expect((await read("q=old%20root")).messages).toEqual([]);
+      expect(
+        (
+          await read("q=Current%20title&tags=tag_one,tag_two&match=all")
+        ).messages.map((m) => m.id),
+      ).toEqual(["root_bumped"]);
+      expect((await read("tags=old_tag")).messages).toEqual([]);
+      expect((await read("q=private")).messages).toEqual([]);
+      expect(
+        first.changes.every(
+          (c) => c.conversationId === cid && c.payload.text !== "private reply",
+        ),
+      ).toBe(true);
+      await expectStatus(outsider.req("GET", `${path}?kind=forum`), 404);
+      await expectStatus(
+        member.req("GET", `${path}?kind=main&sort=latest`),
+        400,
+      );
+      await owner.req("PUT", `/v1/conversations/${cid}/overwrites`, {
+        subject: `user:${member.userId}`,
+        allow: [],
+        deny: ["channels.view"],
+      });
+      await expectStatus(member.req("GET", `${path}?kind=forum`), 404);
+    });
+  });
diff --git a/server/test/forum_tag_policy.test.ts b/server/test/forum_tag_policy.test.ts
new file mode 100644
index 00000000..a096968f
--- /dev/null
+++ b/server/test/forum_tag_policy.test.ts
@@ -0,0 +1,151 @@
+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+import { expectStatus, startServer, type Harness } from "./support/harness.js";
+for (const backend of process.env.MELDIQ_TEST_PG_URL
+  ? ["postgres"]
+  : ["sqlite", "mongodb"])
+  describe(`forum tag policy (${backend})`, () => {
+    let h: Harness;
+    beforeAll(async () => {
+      h = await startServer({
+        MONGODB_DOMAINS:
+          backend === "mongodb" ? "workspace,conversations,files,calls" : "",
+      });
+    });
+    afterAll(async () => h?.close());
+    it("enforces required/restricted tags server-side, protects text edits and rolls back invalid combined settings", async () => {
+      const owner = await h.client("policyowner"),
+        member = await h.client("policymember");
+      owner.serverMessages = member.serverMessages = true;
+      const org = (
+        await owner.req("POST", "/v1/orgs", { name: "Forum policy fixture" })
+      ).org.id;
+      const code = (
+        await owner.req("POST", `/v1/orgs/${org}/invites`, { role: "MEMBER" })
+      ).invite.code;
+      await member.req("POST", "/v1/invites/accept", { code });
+      const cid = (
+        await owner.req("POST", `/v1/orgs/${org}/channels`, {
+          name: "policy-forum",
+          format: "forum",
+          scope: "ORG",
+        })
+      ).channel.id;
+      await expectStatus(
+        owner.req("PATCH", `/v1/conversations/${cid}`, {
+          name: "Must roll back",
+          noGifs: true,
+          requireForumTag: true,
+        }),
+        400,
+      );
+      const unchanged = (await owner.req("GET", `/v1/conversations/${cid}`))
+        .conversation;
+      expect(unchanged).toMatchObject({
+        name: "policy-forum",
+        requireForumTag: false,
+        options: { noGifs: false },
+      });
+      const configured = (
+        await owner.req("PATCH", `/v1/conversations/${cid}`, {
+          requireForumTag: true,
+          forumTags: [{ name: "General" }, { name: "Staff", restricted: true }],
+        })
+      ).conversation;
+      const general = configured.forumTags.find(
+          (t: any) => t.name === "General",
+        ).id,
+        staff = configured.forumTags.find((t: any) => t.name === "Staff").id;
+      await expectStatus(
+        member.req("PATCH", `/v1/conversations/${cid}`, {
+          requireForumTag: false,
+        }),
+        403,
+      );
+      await expectStatus(
+        member.send(cid, { type: "text", text: "Missing tag" }),
+        400,
+      );
+      await expectStatus(
+        member.send(cid, {
+          type: "text",
+          text: "Unknown tag",
+          tags: ["forged"],
+        }),
+        400,
+      );
+      await expectStatus(
+        member.send(cid, {
+          type: "text",
+          text: "Forged moderator selection",
+          tags: [staff],
+        }),
+        403,
+      );
+      const created = await member.send(cid, {
+        type: "text",
+        text: "Tagged root",
+        title: "Tagged root",
+        tags: [general],
+      });
+      await member.send(
+        cid,
+        { type: "edit", target: created.messageId, text: "Edited root" },
+        "control",
+      );
+      await expectStatus(
+        member.send(
+          cid,
+          {
+            type: "edit",
+            target: created.messageId,
+            text: "Add staff",
+            tags: [staff],
+          },
+          "control",
+        ),
+        403,
+      );
+      await expectStatus(
+        member.send(
+          cid,
+          {
+            type: "edit",
+            target: created.messageId,
+            text: "Remove all",
+            tags: [],
+          },
+          "control",
+        ),
+        400,
+      );
+      await owner.send(cid, {
+        type: "text",
+        text: "Staff root",
+        tags: [staff],
+      });
+      // Omission by an older manager client preserves the restricted flag and required policy.
+      const preserved = (
+        await owner.req("PATCH", `/v1/conversations/${cid}`, {
+          forumTags: configured.forumTags.map((t: any) => ({
+            id: t.id,
+            name: t.name,
+          })),
+        })
+      ).conversation;
+      expect(preserved.requireForumTag).toBe(true);
+      expect(
+        preserved.forumTags.find((t: any) => t.id === staff).restricted,
+      ).toBe(true);
+      member.serverMessages = false;
+      await expectStatus(
+        member.send(cid, { type: "text", text: "Encrypted metadata bypass" }),
+        400,
+      );
+      member.serverMessages = true;
+      await member.send(cid, {
+        type: "text",
+        text: "Reply does not need a tag",
+        threadRoot: created.messageId,
+      });
+    });
+  });
