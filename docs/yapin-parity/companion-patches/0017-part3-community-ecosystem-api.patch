+    const check = pg
+      ? `EXISTS(SELECT 1 FROM jsonb_array_elements_text(CASE WHEN jsonb_typeof(${mentions})='array' THEN ${mentions} ELSE '[]'::jsonb END) a(value) WHERE a.value IN (${mentioned.map(bind).join(",")}))`
