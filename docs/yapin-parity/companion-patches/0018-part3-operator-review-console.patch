diff --git a/e2e/ecosystem.spec.ts b/e2e/ecosystem.spec.ts
new file mode 100644
index 0000000..65414a4
--- /dev/null
+++ b/e2e/ecosystem.spec.ts
@@ -0,0 +1,69 @@
+import { expect, test } from "@playwright/test";
+import fs from "node:fs";
+import { API_PORT, STATE_FILE } from "./global-setup";
+
+test("operators review private community reports and partner applications with failed-save recovery on desktop and phone", async ({ page }) => {
+  const s = JSON.parse(fs.readFileSync(STATE_FILE, "utf8"));
+  const cdp = await page.context().newCDPSession(page);
+  await cdp.send("WebAuthn.enable");
+  await cdp.send("WebAuthn.addVirtualAuthenticator", {
+    options: { protocol: "ctap2", transport: "internal", hasResidentKey: true, hasUserVerification: true, isUserVerified: true, automaticPresenceSimulation: true },
+  });
+  await page.goto("/#/enrol");
+  await page.getByLabel("Email").fill(s.ecosystem.email);
+  await page.getByLabel("Password of your Meldiq account").fill(s.ecosystem.password);
+  await page.getByLabel("Enrolment code").fill(s.ecosystem.enrolment);
+  await page.getByRole("button", { name: "Create passkey and sign in" }).click();
+  await expect(page.getByRole("heading", { name: "Dashboard", level: 1 })).toBeVisible();
+  await page.goto(`/#/reports/${s.communityReportId}`);
+  await expect(page.getByRole("region", { name: "Report metadata", exact: true })).toContainText(s.orgId);
+  await expect(page.getByRole("region", { name: "Community report note", exact: true })).toContainText("<script>literal note</script>");
+  await page.goto(`/#/reports/${s.reportId}`);
+  await expect(page.getByRole("heading", { name: "Report review", level: 1 })).toBeVisible();
+  await expect(page.getByText("Private reporter note: never in the console")).toHaveCount(0);
+  await expect(page.getByRole("region", { name: "Community report note", exact: true })).toHaveCount(0);
+  await page.goto("/#/partners");
+  await expect(page.getByText("Owner statement <script>literal text</script>", { exact: true })).toBeVisible();
+  await page.getByRole("button", { name: "Decline application", exact: true }).click();
+  const decline = page.getByRole("dialog", { name: "Decline partner application", exact: true });
+  await expect(decline.getByRole("button", { name: "Record decision", exact: true })).toBeDisabled();
+  await decline.getByLabel(/Reason/).fill("Please describe your moderation coverage");
+  await page.route(
+    "**/admin/v1/partner-applications/*",
+    async (route) => {
+      await route.fulfill({ status: 503, contentType: "application/json", body: JSON.stringify({ error: { code: "unavailable", message: "Temporary review failure" } }) });
+    },
+    { times: 1 },
+  );
+  await decline.getByRole("button", { name: "Record decision", exact: true }).click();
+  await expect(decline.getByRole("alert")).toBeVisible();
+  await expect(decline.getByLabel(/Reason/)).toHaveValue("Please describe your moderation coverage");
+  await decline.getByRole("button", { name: "Record decision", exact: true }).click();
+  const stepUp = page.getByRole("dialog", { name: "Confirm it's you" });
+  await expect(stepUp.or(page.getByRole("status")).first()).toBeVisible();
+  if (await stepUp.isVisible()) await stepUp.getByRole("button", { name: "Use passkey" }).click();
+  await expect(page.getByRole("status")).toContainText("Partner review recorded");
+  await expect(page.getByText("No applications awaiting review", { exact: true })).toBeVisible();
+  const ownerRequest = async (method: string, body?: unknown) => {
+    const r = await fetch(`http://127.0.0.1:${API_PORT}/v1/orgs/${s.orgId}/partner-application`, {
+      method,
+      headers: { authorization: `Bearer ${s.ownerToken}`, "content-type": "application/json" },
+      ...(body ? { body: JSON.stringify(body) } : {}),
+    });
+    expect(r.ok).toBe(true);
+    return r.json();
+  };
+  const declined = (await ownerRequest("GET")).application;
+  expect(declined.status).toBe("declined");
+  await ownerRequest("PUT", { baseRev: declined.rev, statement: "Updated moderation coverage", checklist: { guidelines: true, moderation: true, safety: true, activity: true } });
+  await page.setViewportSize({ width: 390, height: 844 });
+  await page.reload();
+  await expect(page.getByText("Updated moderation coverage", { exact: true })).toBeVisible();
+  await page.getByRole("button", { name: "Approve application", exact: true }).click();
+  const approve = page.getByRole("dialog", { name: "Approve partner application", exact: true });
+  await approve.getByLabel(/Reason/).fill("Manual review completed with the updated coverage");
+  await approve.getByRole("button", { name: "Record decision", exact: true }).click();
+  await expect(page.getByRole("status")).toContainText("Partner review recorded");
+  expect((await ownerRequest("GET")).application.status).toBe("approved");
+  expect(await page.evaluate(() => document.documentElement.scrollWidth - document.documentElement.clientWidth)).toBeLessThanOrEqual(0);
+});
