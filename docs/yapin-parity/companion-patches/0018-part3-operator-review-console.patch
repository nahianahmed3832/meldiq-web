diff --git a/src/console/pages/Partners.tsx b/src/console/pages/Partners.tsx
new file mode 100644
index 0000000..7e98e84
--- /dev/null
+++ b/src/console/pages/Partners.tsx
@@ -0,0 +1,105 @@
+import { useState } from "react";
+import type { z } from "zod/v4";
+import { api, withQuery } from "../../api/client";
+import { PartnerQueue, PartnerResult, PartnerReview as PartnerReviewBody } from "../../api/platformFeatures";
+import { useResource } from "../../app/useResource";
+import { Card, KeyValues } from "../kit/Card";
+import { Pagination } from "../kit/DataTable";
+import { ConfirmDialog } from "../kit/Dialog";
+import { PageHeader } from "../kit/PageHeader";
+import { EmptyState, ErrorState, Loading } from "../kit/States";
+import { Timestamp } from "../kit/Timestamp";
+import { href, navigate, type Route } from "../router";
+
+type Application = z.infer<typeof PartnerQueue>["applications"][number];
+
+export function Partners({ route }: { route: Route }) {
+  const after = route.params.get("after") ?? "";
+  const r = useResource(() => api(PartnerQueue, "GET", withQuery("/admin/v1/partner-applications", { after, limit: 25 })), after);
+  const [notice, setNotice] = useState("");
+  return (
+    <>
+      <PageHeader title="Partner reviews" description="Review private owner applications. Approval records a decision; it does not award a badge, role or entitlement." />
+      {notice && (
+        <p className="banner" role="status">
+          {notice}
+        </p>
+      )}
+      <div className="stack">
+        <button className="btn" onClick={r.reload}>
+          Refresh applications
+        </button>
+        {r.state === "loading" ? (
+          <Loading label="Loading partner applications" />
+        ) : r.state === "error" ? (
+          <ErrorState error={r.error} onRetry={r.reload} />
+        ) : (
+          <>
+            {r.data.applications.length === 0 ? (
+              <EmptyState title="No applications awaiting review" />
+            ) : (
+              r.data.applications.map((application) => (
+                <PartnerReview
+                  key={`${application.orgId}-${application.rev}`}
+                  application={application}
+                  onSaved={() => {
+                    setNotice("Partner review recorded. The owner can view the decision.");
+                    r.reload();
+                  }}
+                />
+              ))
+            )}
+            <Pagination
+              shown={r.data.applications.length}
+              isFirst={!after}
+              hasNext={!!r.data.nextAfter}
+              onFirst={() => navigate(href("partners"))}
+              onNext={() => navigate(href("partners", null, { after: r.data.nextAfter ?? undefined }))}
+            />
+          </>
+        )}
+      </div>
+    </>
+  );
+}
+
+function PartnerReview({ application: v, onSaved }: { application: Application; onSaved: () => void }) {
+  const [decision, setDecision] = useState<"approved" | "declined" | null>(null);
+  return (
+    <Card title={`Application: ${v.orgId}`} sub={`Revision ${v.rev}`}>
+      <KeyValues
+        items={[
+          ["Community", <a href={href("org", v.orgId)}>{v.orgId}</a>],
+          ["Submitted", <Timestamp at={v.submittedAt} mode="absolute" />],
+          ["Guidelines", v.checklist.guidelines ? "Confirmed by owner" : "Not confirmed"],
+          ["Active moderation", v.checklist.moderation ? "Confirmed by owner" : "Not confirmed"],
+          ["Safety processes", v.checklist.safety ? "Confirmed by owner" : "Not confirmed"],
+          ["Community activity", v.checklist.activity ? "Confirmed by owner" : "Not confirmed"],
+        ]}
+      />
+      <h3>Owner statement</h3>
+      <p style={{ whiteSpace: "pre-wrap", overflowWrap: "anywhere" }}>{v.statement}</p>
+      <div className="row" style={{ gap: 8 }}>
+        <button className="btn btn-primary" onClick={() => setDecision("approved")}>
+          Approve application
+        </button>
+        <button className="btn" onClick={() => setDecision("declined")}>
+          Decline application
+        </button>
+      </div>
+      <ConfirmDialog
+        reasonMin={PartnerReviewBody.shape.reason.minLength ?? 10}
+        open={decision !== null}
+        title={decision === "approved" ? "Approve partner application" : "Decline partner application"}
+        description="Your reason is shared privately with the owner and recorded in the operator audit. This decision does not assign a badge or change community access. If the application has changed, refresh before reviewing again."
+        confirmLabel="Record decision"
+        onClose={() => setDecision(null)}
+        onConfirm={async (reason) => {
+          if (!decision) return;
+          await api(PartnerResult, "PUT", `/admin/v1/partner-applications/${encodeURIComponent(v.orgId)}`, { baseRev: v.rev, status: decision, reason });
+          onSaved();
+        }}
+      />
+    </Card>
+  );
+}
