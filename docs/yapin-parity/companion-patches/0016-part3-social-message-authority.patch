diff --git a/server/src/modules/accounts/relationships/routes.ts b/server/src/modules/accounts/relationships/routes.ts
index 18b0f4b2..be1e56c8 100644
--- a/server/src/modules/accounts/relationships/routes.ts
+++ b/server/src/modules/accounts/relationships/routes.ts
@@ -76,10 +76,11 @@ export default async function connectionRoutes(app: FastifyInstance, ctx: AppCon
   app.post("/v1/connections/:userId/accept", auth, async (req) => {
     const userId = me(req).userId;
     const { userId: from } = parse(ConnectionUserParams, req.params);
-    const row = await rel.connection(userId, from);
-    if (!row || row.state !== "pending" || row.requested_by === userId || blockedEitherWay(ctx, userId, from)) throw notFound("Request not found");
-    await rel.putConnection({ ...row, state: "accepted", accepted_at: now() });
-    changed(userId, from);
+    if (blockedEitherWay(ctx, userId, from)) throw notFound("Request not found");
+    // A retry after a lost response succeeds without changing its timestamp or emitting another event. The
+    // conditional update also prevents a stale accept from recreating a request removed on another device.
+    if (await rel.acceptConnection(userId, from, now())) changed(userId, from);
+    else if ((await rel.connection(userId, from))?.state !== "accepted") throw notFound("Request not found");
     return { state: "accepted" };
   });
 
diff --git a/server/src/modules/accounts/relationships/store.ts b/server/src/modules/accounts/relationships/store.ts
index 05f3dc4f..fa2af5f8 100644
--- a/server/src/modules/accounts/relationships/store.ts
+++ b/server/src/modules/accounts/relationships/store.ts
@@ -47,6 +47,8 @@ export interface RelationshipStore {
   connectionsOf(userId: string): Promise<ConnectionRow[]>;
   /** Inserts or replaces the pair's row. */
   putConnection(row: ConnectionRow): Promise<void>;
+  /** Accepts only an existing pending request from [from] to [recipient]. No upsert; true only on transition. */
+  acceptConnection(recipient: string, from: string, at: number): Promise<boolean>;
   deleteConnection(x: string, y: string): Promise<boolean>;
   request(conversationId: string): Promise<DmRequestRow | null>;
   createRequest(row: DmRequestRow): Promise<void>;
@@ -92,6 +94,11 @@ export class SqliteRelationshipStore implements RelationshipStore {
     return this.db.prepare("DELETE FROM connections WHERE pair = ?").run(pairOf(x, y).pair).changes > 0;
   }
 
+  async acceptConnection(recipient: string, from: string, at: number): Promise<boolean> {
+    return this.db.prepare("UPDATE connections SET state = 'accepted', accepted_at = ? WHERE pair = ? AND state = 'pending' AND requested_by = ?")
+      .run(at, pairOf(recipient, from).pair, from).changes === 1;
+  }
+
   async request(conversationId: string): Promise<DmRequestRow | null> {
     return (this.db.prepare("SELECT * FROM dm_requests WHERE conversation_id = ?").get(conversationId) as DmRequestRow | undefined) ?? null;
   }
