+      await waiting;
+      await sender.req("DELETE", `/v1/connections/${recipient.userId}`);
+      release();
+      await result;
+      expect(await h.ctx.relationships.connection(sender.userId, recipient.userId)).toBeNull();
+    } finally {
+      release();
+      transition.mockRestore();
+    }
+  });
