+package com.meldiq.android.call
+
+import com.meldiq.android.crypto.Hpke
+import com.meldiq.android.crypto.b64
+import com.meldiq.android.crypto.sha256
+import com.meldiq.android.crypto.unb64
+import com.meldiq.android.data.api.BotVoiceKeyRequestDto
+import com.meldiq.android.data.api.BotVoicePacketDto
+import com.meldiq.android.data.api.CallDto
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import kotlinx.serialization.json.JsonArray
+import kotlinx.serialization.json.JsonPrimitive
+
+/** Same HPKE suite/AAD as Web and the optional bot SDK. Only ciphertext leaves this client. */
+object BotVoiceKeys {
+    const val INFO = "meldiq-bot-voice-v1"
+    private val id = Regex("[A-Za-z0-9_-]{1,64}")
+    fun aad(callId: String, channelId: String, request: BotVoiceKeyRequestDto): ByteArray = JsonArray(listOf(
+        JsonPrimitive(INFO), JsonPrimitive(callId), JsonPrimitive(channelId), JsonPrimitive(request.botId),
+        JsonPrimitive(request.leaseId), JsonPrimitive(request.manifestRev),
+    )).toString().toByteArray(Charsets.UTF_8)
+
+    fun seal(request: BotVoiceKeyRequestDto, callId: String, channelId: String, key: String, now: Long = System.currentTimeMillis()): BotVoicePacketDto {
+        require(listOf(callId, channelId, request.botId, request.leaseId).all(id::matches))
+        require(request.expiresAt > now && request.manifestRev > 0)
+        val publicKey = request.publicKey.unb64()
+        val roomKey = key.unb64()
+        require(publicKey.size == 32 && publicKey.b64() == request.publicKey && roomKey.size == 32)
+        require(sha256(publicKey).joinToString("") { "%02x".format(it) } == request.fingerprint)
+        val (enc, ct) = Hpke.seal(publicKey, INFO.toByteArray(Charsets.UTF_8), aad(callId, channelId, request), roomKey)
+        return BotVoicePacketDto(enc.b64(), ct.b64())
+    }
+}
+
+/** Per-call bounded metadata only. No additional room-key persistence, logs or background polling. */
+class BotVoiceKeyRelay {
+    private val lock = Any()
+    private val pending = HashSet<String>()
+    private val shared = LinkedHashSet<String>()
+    fun clear() = synchronized(lock) { pending.clear(); shared.clear() }
+
+    suspend fun share(call: CallDto, userId: String, deviceId: String, key: String, active: () -> Boolean, send: suspend (String, BotVoicePacketDto) -> Unit) {
+        if (!call.voiceRoom || call.state != "ACTIVE" || !call.participants.any { it.userId == userId && it.deviceId == deviceId } || !active()) return
+        for (request in call.botVoice.take(128)) {
+            val start = synchronized(lock) { pending.size < 128 && request.leaseId !in shared && pending.add(request.leaseId) }
+            if (!start) continue
+            try {
+                val packet = withContext(Dispatchers.Default) { BotVoiceKeys.seal(request, call.id, call.conversationId, key) }
+                if (!active()) return
+                send(request.leaseId, packet)
+                if (active()) synchronized(lock) {
+                    shared += request.leaseId
+                    while (shared.size > 128) shared.remove(shared.first())
+                }
+            } catch (cancel: CancellationException) {
+                throw cancel
+            } catch (_: Exception) {
+                // A current pending request is reannounced by the lease heartbeat; no private material is logged.
+            } finally {
+                synchronized(lock) { pending.remove(request.leaseId) }
+            }
+        }
+    }
+}
