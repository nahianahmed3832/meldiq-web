+package com.meldiq.android.call
+
+import com.meldiq.android.crypto.Hpke
+import com.meldiq.android.crypto.unb64
+import com.meldiq.android.data.api.BotVoiceKeyRequestDto
+import com.meldiq.android.data.api.BotVoicePacketDto
+import com.meldiq.android.data.api.CallDto
+import com.meldiq.android.data.api.CallParticipantDto
+import com.meldiq.android.data.api.GriipJson
+import com.meldiq.android.data.api.RealtimeCodec
+import com.meldiq.android.data.api.ServerEvent
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.async
+import kotlinx.coroutines.awaitAll
+import kotlinx.coroutines.runBlocking
+import kotlinx.serialization.Serializable
+import org.junit.Assert.*
+import org.junit.Test
+
+class BotVoiceKeysTest {
+    @Serializable private data class Vector(val scope: String, val callId: String, val channelId: String, val request: BotVoiceKeyRequestDto, val privateKey: String, val roomKey: String, val aad: String, val packet: BotVoicePacketDto)
+    private val vector = GriipJson.decodeFromString<Vector>(javaClass.classLoader!!.getResource("bot_voice_hpke_node.json")!!.readText())
+    private fun open(packet: BotVoicePacketDto, request: BotVoiceKeyRequestDto = vector.request, callId: String = vector.callId, channelId: String = vector.channelId): ByteArray = Hpke.open(
+        vector.privateKey.unb64(), vector.request.publicKey.unb64(), packet.enc.unb64(), BotVoiceKeys.INFO.toByteArray(),
+        BotVoiceKeys.aad(callId, channelId, request), packet.ct.unb64(),
+    )
+    private fun call() = CallDto(vector.callId, vector.channelId, createdBy = "human", video = false, state = "ACTIVE", createdAt = 1,
+        voiceRoom = true, participants = listOf(CallParticipantDto("human", "phone", 1)), botVoice = listOf(vector.request))
+
+    @Test fun `opens the Node HPKE packet using the exact shared context`() {
+        assertEquals(vector.aad, String(BotVoiceKeys.aad(vector.callId, vector.channelId, vector.request)))
+        assertArrayEquals(vector.roomKey.unb64(), open(vector.packet))
+        val own = BotVoiceKeys.seal(vector.request, vector.callId, vector.channelId, vector.roomKey)
+        assertArrayEquals(vector.roomKey.unb64(), open(own))
+        assertNotEquals(vector.packet.enc, own.enc)
+        assertEquals(48, own.ct.unb64().size)
+        // Synthetic fixture only: let the first-party Node SDK independently open Android's packet.
+        java.io.File("build/tmp/bot-voice-interop/android-packet.json").also { file ->
+            file.parentFile.mkdirs()
+            file.writeText(GriipJson.encodeToString(BotVoicePacketDto.serializer(), own))
+        }
+    }
+
+    @Test fun `decodes the real API frame and keeps old call frames compatible`() {
+        val fixture = javaClass.classLoader!!.getResource("bot_voice_call_api.json")!!.readText()
+        val event = RealtimeCodec.decode(fixture) as ServerEvent.Call
+        assertEquals(1, event.call.botVoice.size)
+        assertTrue(event.call.voiceRoom)
+        assertEquals(32, event.call.botVoice.single().publicKey.unb64().size)
+        assertTrue(GriipJson.decodeFromString<CallDto>("""{"id":"old","conversationId":"channel","createdBy":"human","video":false,"state":"ACTIVE","createdAt":1}""").botVoice.isEmpty())
+    }
+
+    @Test fun `rejects every context substitution and expired or mismatched public keys`() {
+        val alternatives = listOf(
+            { open(vector.packet, callId = "other_call") }, { open(vector.packet, channelId = "other_channel") },
+            { open(vector.packet, request = vector.request.copy(botId = "other_bot")) },
+            { open(vector.packet, request = vector.request.copy(leaseId = "other_lease")) },
+            { open(vector.packet, request = vector.request.copy(manifestRev = 8)) },
+        )
+        for (attempt in alternatives) assertTrue(runCatching { attempt() }.isFailure)
+        for (request in listOf(vector.request.copy(expiresAt = 1), vector.request.copy(fingerprint = "0".repeat(64)), vector.request.copy(publicKey = vector.request.publicKey + "\n"))) {
+            assertTrue(runCatching { BotVoiceKeys.seal(request, vector.callId, vector.channelId, vector.roomKey) }.isFailure)
+        }
+    }
+
+    @Test fun `shares only from the current participating device and retries a failed delivery`() = runBlocking {
+        val relay = BotVoiceKeyRelay()
+        var sent = 0
+        val send: suspend (String, BotVoicePacketDto) -> Unit = { _, _ -> sent++ }
+        relay.share(call(), "human", "other_phone", vector.roomKey, { true }, send)
+        relay.share(call(), "human", "phone", vector.roomKey, { false }, send)
+        relay.share(call().copy(state = "ENDED"), "human", "phone", vector.roomKey, { true }, send)
+        assertEquals(0, sent)
+        relay.share(call(), "human", "phone", vector.roomKey, { true }) { _, _ -> throw java.io.IOException("temporary failure") }
+        relay.share(call(), "human", "phone", vector.roomKey, { true }, send)
+        relay.share(call(), "human", "phone", vector.roomKey, { true }, send)
+        assertEquals(1, sent)
+    }
+
+    @Test fun `concurrent call frames send a lease packet once`() = runBlocking {
+        val relay = BotVoiceKeyRelay()
+        val entered = CompletableDeferred<Unit>()
+        val release = CompletableDeferred<Unit>()
+        var sent = 0
+        val jobs = List(12) { async {
+            relay.share(call(), "human", "phone", vector.roomKey, { true }) { _, packet ->
+                assertArrayEquals(vector.roomKey.unb64(), open(packet))
+                sent++
+                entered.complete(Unit)
+                release.await()
+            }
+        } }
+        entered.await()
+        release.complete(Unit)
+        jobs.awaitAll()
+        assertEquals(1, sent)
+    }
+}
